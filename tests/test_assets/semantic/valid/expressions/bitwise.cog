BITWISE_AND: u8 :
    cast(u8, 240) & 15;

BITWISE_OR: u8 :
    cast(u8, 240) | 15;

BITWISE_XOR: u8 :
    cast(u8, 240) ^ 15;

BITWISE_NOT_UNSIGNED: u8 :
    ~cast(u8, 0);

BITWISE_NOT_SIGNED: s8 :
    ~cast(s8, 0);

UNTYPED_NOT: s32 :
    ~0;

UNTYPED_BINARY: s32 :
    240 & 15;

SIGNED_PATTERN: s8 :
    cast(s8, -128) | 1;

bitwise_runtime::(
    signed_value: s32,
    signed_mask: s32,
    unsigned_value: u32,
    unsigned_mask: u32
) -> void {
    signed_and: s32 =
        signed_value & signed_mask;

    signed_or: s32 =
        signed_value | signed_mask;

    signed_xor: s32 =
        signed_value ^ signed_mask;

    signed_not: s32 =
        ~signed_value;

    unsigned_and: u32 =
        unsigned_value & unsigned_mask;

    unsigned_or: u32 =
        unsigned_value | unsigned_mask;

    unsigned_xor: u32 =
        unsigned_value ^ unsigned_mask;

    unsigned_not: u32 =
        ~unsigned_value;

    contextual_left: u32 =
        255 & unsigned_value;

    contextual_right: u32 =
        unsigned_value | 255;
}

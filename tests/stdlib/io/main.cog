import std.io;

main::() -> s32 {
    std.io.print("text");
    std.io.println(" + line");

    bytes: u8[4] = [115, 108, 105, 99];
    std.io.print("view = ");
    std.io.println(bytes);

    std.io.print_bool(true);
    std.io.print(" ");
    std.io.print_bool(false);
    std.io.newline();

    std.io.print_s8(-8);
    std.io.print(" ");
    std.io.print_s16(-1600);
    std.io.print(" ");
    std.io.print_s32(-320000);
    std.io.print(" ");
    std.io.print_s64(-6400000000);
    std.io.newline();

    std.io.print_u8(8);
    std.io.print(" ");
    std.io.print_u16(1600);
    std.io.print(" ");
    std.io.print_u32(320000);
    std.io.print(" ");
    std.io.print_u64(6400000000);
    std.io.newline();

    value32: f32 = 1.5;
    value64: f64 = -2.25;
    std.io.print_f32(value32);
    std.io.print(" ");
    std.io.print_f64(value64);
    std.io.newline();

    path := "stdlib_io_file_test.tmp";
    writer := std.io.File.open_write(path);
    if (!writer.is_open()) {
        return 1;
    }
    if (writer.write("hello") != 5) {
        writer.close();
        return 2;
    }
    if (!writer.flush()) {
        writer.close();
        return 3;
    }
    writer.close();

    reader := std.io.File.open_read(path);
    if (!reader.is_open()) {
        discard std.io.remove_file(path);
        return 4;
    }

    buffer: u8[5] = [0, 0, 0, 0, 0];
    if (reader.read(buffer) != 5) {
        reader.close();
        discard std.io.remove_file(path);
        return 5;
    }
    if (reader.eof() || reader.error()) {
        reader.close();
        discard std.io.remove_file(path);
        return 6;
    }
    reader.close();

    std.io.print("file = ");
    std.io.println(buffer);

    if (!std.io.remove_file(path)) {
        return 7;
    }

    std.io.flush();
    return 0;
}

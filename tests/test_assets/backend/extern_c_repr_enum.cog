#repr(c)
BackendMode::enum(c_int) {
    Idle = -1,
    Running = 3,
}

#repr(c)
BackendEnumPacket::struct {
    current: BackendMode;
    history: BackendMode[2];
}

#extern(c)
coglet_backend_make_enum_packet::() -> BackendEnumPacket;

#extern(c)
coglet_backend_enum_packet_probe::(mode: BackendMode, packet: BackendEnumPacket) -> c_int;

main::() -> c_int {
    return coglet_backend_enum_packet_probe(
        BackendMode.Running,
        coglet_backend_make_enum_packet()
    );
}

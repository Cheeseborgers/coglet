sink::<A, B, C>(a: A, b: B, c: C) -> s32 {
    return 7;
}

zero_sink::() -> s32 {
    return 11;
}

forward::<...Args>(args: ...Args) -> s32 {
    return sink(args...);
}

forward_empty::<...Args>(args: ...Args) -> s32 {
    return zero_sink(args...);
}

head_forward::<T, ...Args>(head: T, args: ...Args) -> s32 {
    return sink(head, args...);
}

main::() -> s32 {
    a := forward(1, true, 2.0);
    b := forward::<s32, bool, f64>(1, true, 2.0);
    c := forward_empty();
    d := head_forward(1, true, 2.0);

    if a != 7 || b != 7 || c != 11 || d != 7
        return 1;
    return 0;
}

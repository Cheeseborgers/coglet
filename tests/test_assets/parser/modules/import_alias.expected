program
  module app.core
  import std.math as math
  var_decl value: math.Pair
    init:
      struct_init math.Pair
        field_init x
          1
        field_init y
          2
  func run -> s32
    body:
      block
        return
          call
            field .add
              math
            field .x
              value
            field .y
              value

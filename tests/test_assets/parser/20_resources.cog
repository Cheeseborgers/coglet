Handle::resource {
    value: s32;

    new::(value: s32) -> Self {
        return Self { value = value };
    }

    get::(self: readonly Self*) -> s32 {
        return (*self).value;
    }
}

Box::<T> resource {
    value: T;
}

consume::(handle: Handle) -> s32 {
    return handle.get();
}

main::() -> s32 {
    handle := Handle.new(42);
    moved := move handle;
    return consume(move moved);
}

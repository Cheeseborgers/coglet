Shade::enum(u8) {
    Dark,
    Light,
}

Point::struct {
    x: s32;
    y: s32;
}

global_bias: s32 = 5;

compute::(value: s32) -> s32 {
    local: s32 = value + 1;
    point: Point = Point {
        x = local,
        y = global_bias,
    };
    samples: s32[2] = [point.x, point.y];
    shade: Shade = Shade.Light;

    if value > 0
        return samples[0] + samples[1] + cast(s32, shade);

    return 0;
}

main::() -> s32 {
    return compute(7);
}

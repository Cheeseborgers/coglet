import std.io;
import std.math;

main::() -> s32 {
    position := std.math.Vec3::<f32>.new(10.0, 5.0, 2.0);
    velocity := std.math.Vec3::<f32>.new(1.0, 0.0, -2.0);
    next := position.add(velocity).scale(0.5);

    std.io.print("next = (");
    std.io.print_f32(next.x);
    std.io.print(", ");
    std.io.print_f32(next.y);
    std.io.print(", ");
    std.io.print_f32(next.z);
    std.io.println(")");

    x_axis := std.math.Vec3::<s32> { x = 1, y = 0, z = 0 };
    y_axis := std.math.Vec3::<s32>.new(0, 1, 0);
    z_axis := x_axis.cross(y_axis);

    std.io.print("cross = (");
    std.io.print_s32(z_axis.x);
    std.io.print(", ");
    std.io.print_s32(z_axis.y);
    std.io.print(", ");
    std.io.print_s32(z_axis.z);
    std.io.println(")");

    tile := std.math.Vec2::<s32>.new(3, 4);
    std.io.print("tile length^2 = ");
    std.io.print_s32(tile.length_squared());
    std.io.newline();

    color := std.math.Vec4::<f32>.splat(0.5);
    std.io.print("color dot color = ");
    std.io.print_f32(color.dot(color));
    std.io.newline();

    return 0;
}

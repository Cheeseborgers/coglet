PI :: 0x1.921fb54442d18p+1;
TAU :: 0x1.921fb54442d18p+2;

use_f32::(value: f32) -> f32 {
    return value;
}

use_f64::(value: f64) -> f64 {
    return value;
}

main::() -> s32 {
    ps32: f32 = PI;
    ps64: f64 = PI;
    tau32: f32 = TAU;
    tau64: f64 = TAU;

    discard use_f32(PI);
    discard use_f64(PI);

    if ps32 <= tau32 && ps64 <= tau64
        return 0;

    return 1;
}

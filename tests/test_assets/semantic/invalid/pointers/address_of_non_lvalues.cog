VALUE :: 1;

Color :: enum {
    Red,
}

Point :: struct {
    x: s32;
}

make_point::() -> Point {
    return Point {
        x = 0,
    };
}

make_value::() -> s32 {
    return 1;
}

test::() -> void {
    a: s32* = &VALUE;
    b: Color* = &Color.Red;
    c: s32* = &1;
    d: s32* = &(1 + 2);
    e: s32* = &make_value();
    f: s32* = &make_point().x;
}

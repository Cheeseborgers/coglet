module target(pointer=64)
type %t0 "Pair" = struct {tag: u8, value: u64}
type %t7 "s32[]" = struct {data: ptr<s32>, len: u64}
entry @f0 "main"() -> s32 [abi=coglet, linkage=internal] {
  slots:
    $s0 : [3]s32 "values"
    $s1 : ptr<s32> "pointer"
    $s2 : %t7 "view"
  bb0 "entry"():
    %0 = local_addr $s0
    %1 = const s32 @c0(0xa)
    %2 = const s32 @c1(0x14)
    %3 = const s32 @c2(0x1e)
    %4 = make_array (%1, %2, %3)
    store %0, %4
    %5 = local_addr $s1
    %6 = local_addr $s0
    %7 = const s32 @c3(0x0)
    %8 = array_elem_addr %6, %7
    store %5, %8
    %9 = local_addr $s2
    %10 = local_addr $s1
    %11 = load %10
    %12 = const u64 @c4(0x3)
    %13 = make_struct (%11, %12)
    store %9, %13
    %14 = local_addr $s2
    %15 = load %14
    %16 = extract_field %15, 1
    %17 = const u64 @c4(0x3)
    %18 = icmp.ne %16, %17
    %20 = const bool @c5(true)
    cond_br %18, bb2(%20), bb1()
  bb1 "logic.or.rhs"():
    %21 = local_addr $s2
    %22 = load %21
    %23 = extract_field %22, 0
    %24 = const s32 @c6(0x1)
    %25 = ptr_index_addr %23, %24
    %26 = load %25
    %27 = const s32 @c1(0x14)
    %28 = icmp.ne %26, %27
    br bb2(%28)
  bb2 "logic.or.join"(%19: bool):
    cond_br %19, bb3(), bb4()
  bb3 "if.then"():
    %29 = const s32 @c6(0x1)
    ret %29
  bb4 "if.end"():
    %30 = function_ref @f1
    %31 = call %30()
    %32 = align_of %t0
    %33 = icmp.ult %31, %32
    cond_br %33, bb5(), bb6()
  bb5 "if.then"():
    %34 = const s32 @c7(0x2)
    ret %34
  bb6 "if.end"():
    %35 = const s32 @c3(0x0)
    ret %35
}
func @f1 "measure<Pair>"() -> u64 [abi=coglet, linkage=internal] {
  bb0 "entry"():
    %0 = size_of %t0
    %1 = align_of %t0
    %2 = iadd.checked %0, %1
    ret %2
}

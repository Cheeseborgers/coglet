read_value::(
    pointer: readonly s32*
) -> void {
}

return_readonly::(
    pointer: s32*
) -> readonly s32* {
    return pointer;
}

readonly_pointer_conversions::(
    first: s32*,
    second: s32*
) -> void {
    /*
     * Variable initialisation.
     */
    view: readonly s32* = first;

    /*
     * Assignment.
     */
    view = second;

    /*
     * Function argument.
     */
    read_value(first);
    read_value(view);

    /*
     * Null adapts to either access mode.
     */
    empty: readonly s32* = null;

    read_value(null);
}

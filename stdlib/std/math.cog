module std.math;

// Adaptable floating-point constants. Context chooses f32 or f64.
export pi         :: 0x1.921fb54442d18p+1;
export tau        :: 0x1.921fb54442d18p+2;
export e          :: 0x1.5bf0a8b145769p+1;
export half_pi    :: 0x1.921fb54442d18p+0;
export quarter_pi :: 0x1.921fb54442d18p-1;
export inv_pi     :: 0x1.45f306dc9c883p-2;
export inv_tau    :: 0x1.45f306dc9c883p-3;
export sqrt_2     :: 0x1.6a09e667f3bcdp+0;
export deg_to_rad :: 0x1.1df46a2529d39p-6;
export rad_to_deg :: 0x1.ca5dc1a63c1f8p+5;

export abs_s32::(value: s32) -> s32 {
    if value < 0
        return -value;

    return value;
}

export min::<T: ordered>(a: T, b: T) -> T {
    if a < b
        return a;

    return b;
}

export max::<T: ordered>(a: T, b: T) -> T {
    if a > b
        return a;

    return b;
}

// Requires low <= high.
export clamp::<T: ordered>(value: T, low: T, high: T) -> T {
    if value < low
        return low;

    if value > high
        return high;

    return value;
}

export clamp01::<T: floating>(value: T) -> T {
    if value < 0.0
        return 0.0;

    if value > 1.0
        return 1.0;

    return value;
}

// Linear interpolation. t is not clamped, so values outside [0, 1] extrapolate.
export lerp::<T: floating>(a: T, b: T, t: T) -> T {
    return a + (b - a) * t;
}

// Requires a != b.
export inverse_lerp::<T: floating>(a: T, b: T, value: T) -> T {
    return (value - a) / (b - a);
}

// Requires in_min != in_max. The result is not clamped to the output range.
export remap::<T: floating>(in_min: T, in_max: T, out_min: T, out_max: T, value: T) -> T {
    t := inverse_lerp(in_min, in_max, value);
    return lerp(out_min, out_max, t);
}

// Cubic Hermite interpolation from 0 to 1. Requires edge0 < edge1.
export smoothstep::<T: floating>(edge0: T, edge1: T, value: T) -> T {
    t := clamp01((value - edge0) / (edge1 - edge0));
    return t * t * (3.0 - 2.0 * t);
}

export to_radians::<T: floating>(degrees: T) -> T {
    return degrees * deg_to_rad;
}

export to_degrees::<T: floating>(radians: T) -> T {
    return radians * rad_to_deg;
}

// Generic game-oriented vectors. These are ordinary Coglet structs with no
// backend or SIMD special cases. Operations follow the scalar semantics of T.

export Vec2::<T: numeric> struct {
    x: T;
    y: T;

    new::(x: T, y: T) -> Self {
        return Self { x = x, y = y };
    }

    zero::() -> Self {
        return Self { x = 0, y = 0 };
    }

    one::() -> Self {
        return Self { x = 1, y = 1 };
    }

    splat::(value: T) -> Self {
        return Self { x = value, y = value };
    }

    add::(self: Self, other: Self) -> Self {
        return Self {
            x = self.x + other.x,
            y = self.y + other.y
        };
    }

    sub::(self: Self, other: Self) -> Self {
        return Self {
            x = self.x - other.x,
            y = self.y - other.y
        };
    }

    mul::(self: Self, other: Self) -> Self {
        return Self {
            x = self.x * other.x,
            y = self.y * other.y
        };
    }

    scale::(self: Self, scalar: T) -> Self {
        return Self {
            x = self.x * scalar,
            y = self.y * scalar
        };
    }

    divide::(self: Self, scalar: T) -> Self {
        return Self {
            x = self.x / scalar,
            y = self.y / scalar
        };
    }

    neg::(self: Self) -> Self {
        return Self {
            x = -self.x,
            y = -self.y
        };
    }

    dot::(self: Self, other: Self) -> T {
        return self.x * other.x + self.y * other.y;
    }

    length_squared::(self: Self) -> T {
        return self.x * self.x + self.y * self.y;
    }

    distance_squared::(self: Self, other: Self) -> T {
        dx := self.x - other.x;
        dy := self.y - other.y;
        return dx * dx + dy * dy;
    }

    // Available when this concrete vector specialization supports floating sqrt/division.
    length::(self: Self) -> T {
        return sqrt(self.length_squared());
    }

    // Available when this concrete vector specialization supports floating sqrt/division.
    distance::(self: Self, other: Self) -> T {
        return sqrt(self.distance_squared(other));
    }

    // Requires a non-zero vector. Available for floating vector specializations.
    normalized::(self: Self) -> Self {
        magnitude := self.length();
        return self.scale(1.0 / magnitude);
    }

    min::(self: Self, other: Self) -> Self {
        return Self {
            x = min(self.x, other.x),
            y = min(self.y, other.y)
        };
    }

    max::(self: Self, other: Self) -> Self {
        return Self {
            x = max(self.x, other.x),
            y = max(self.y, other.y)
        };
    }

    clamp::(self: Self, low: Self, high: Self) -> Self {
        return Self {
            x = clamp(self.x, low.x, high.x),
            y = clamp(self.y, low.y, high.y)
        };
    }

    operators {
        + = add;
        - = sub;
        * = scale;
        / = divide;
        unary - = neg;
    }
}

export Vec3::<T: numeric> struct {
    x: T;
    y: T;
    z: T;

    new::(x: T, y: T, z: T) -> Self {
        return Self { x = x, y = y, z = z };
    }

    zero::() -> Self {
        return Self { x = 0, y = 0, z = 0 };
    }

    one::() -> Self {
        return Self { x = 1, y = 1, z = 1 };
    }

    splat::(value: T) -> Self {
        return Self { x = value, y = value, z = value };
    }

    add::(self: Self, other: Self) -> Self {
        return Self {
            x = self.x + other.x,
            y = self.y + other.y,
            z = self.z + other.z
        };
    }

    sub::(self: Self, other: Self) -> Self {
        return Self {
            x = self.x - other.x,
            y = self.y - other.y,
            z = self.z - other.z
        };
    }

    mul::(self: Self, other: Self) -> Self {
        return Self {
            x = self.x * other.x,
            y = self.y * other.y,
            z = self.z * other.z
        };
    }

    scale::(self: Self, scalar: T) -> Self {
        return Self {
            x = self.x * scalar,
            y = self.y * scalar,
            z = self.z * scalar
        };
    }

    divide::(self: Self, scalar: T) -> Self {
        return Self {
            x = self.x / scalar,
            y = self.y / scalar,
            z = self.z / scalar
        };
    }

    neg::(self: Self) -> Self {
        return Self {
            x = -self.x,
            y = -self.y,
            z = -self.z
        };
    }

    dot::(self: Self, other: Self) -> T {
        return self.x * other.x + self.y * other.y + self.z * other.z;
    }

    cross::(self: Self, other: Self) -> Self {
        return Self {
            x = self.y * other.z - self.z * other.y,
            y = self.z * other.x - self.x * other.z,
            z = self.x * other.y - self.y * other.x
        };
    }

    length_squared::(self: Self) -> T {
        return self.x * self.x + self.y * self.y + self.z * self.z;
    }

    distance_squared::(self: Self, other: Self) -> T {
        dx := self.x - other.x;
        dy := self.y - other.y;
        dz := self.z - other.z;
        return dx * dx + dy * dy + dz * dz;
    }

    // Available when this concrete vector specialization supports floating sqrt/division.
    length::(self: Self) -> T {
        return sqrt(self.length_squared());
    }

    // Available when this concrete vector specialization supports floating sqrt/division.
    distance::(self: Self, other: Self) -> T {
        return sqrt(self.distance_squared(other));
    }

    // Requires a non-zero vector. Available for floating vector specializations.
    normalized::(self: Self) -> Self {
        magnitude := self.length();
        return self.scale(1.0 / magnitude);
    }

    min::(self: Self, other: Self) -> Self {
        return Self {
            x = min(self.x, other.x),
            y = min(self.y, other.y),
            z = min(self.z, other.z)
        };
    }

    max::(self: Self, other: Self) -> Self {
        return Self {
            x = max(self.x, other.x),
            y = max(self.y, other.y),
            z = max(self.z, other.z)
        };
    }

    clamp::(self: Self, low: Self, high: Self) -> Self {
        return Self {
            x = clamp(self.x, low.x, high.x),
            y = clamp(self.y, low.y, high.y),
            z = clamp(self.z, low.z, high.z)
        };
    }

    operators {
        + = add;
        - = sub;
        * = scale;
        / = divide;
        unary - = neg;
    }
}

export Vec4::<T: numeric> struct {
    x: T;
    y: T;
    z: T;
    w: T;

    new::(x: T, y: T, z: T, w: T) -> Self {
        return Self { x = x, y = y, z = z, w = w };
    }

    zero::() -> Self {
        return Self { x = 0, y = 0, z = 0, w = 0 };
    }

    one::() -> Self {
        return Self { x = 1, y = 1, z = 1, w = 1 };
    }

    splat::(value: T) -> Self {
        return Self { x = value, y = value, z = value, w = value };
    }

    add::(self: Self, other: Self) -> Self {
        return Self {
            x = self.x + other.x,
            y = self.y + other.y,
            z = self.z + other.z,
            w = self.w + other.w
        };
    }

    sub::(self: Self, other: Self) -> Self {
        return Self {
            x = self.x - other.x,
            y = self.y - other.y,
            z = self.z - other.z,
            w = self.w - other.w
        };
    }

    mul::(self: Self, other: Self) -> Self {
        return Self {
            x = self.x * other.x,
            y = self.y * other.y,
            z = self.z * other.z,
            w = self.w * other.w
        };
    }

    scale::(self: Self, scalar: T) -> Self {
        return Self {
            x = self.x * scalar,
            y = self.y * scalar,
            z = self.z * scalar,
            w = self.w * scalar
        };
    }

    divide::(self: Self, scalar: T) -> Self {
        return Self {
            x = self.x / scalar,
            y = self.y / scalar,
            z = self.z / scalar,
            w = self.w / scalar
        };
    }

    neg::(self: Self) -> Self {
        return Self {
            x = -self.x,
            y = -self.y,
            z = -self.z,
            w = -self.w
        };
    }

    dot::(self: Self, other: Self) -> T {
        return self.x * other.x + self.y * other.y +
               self.z * other.z + self.w * other.w;
    }

    length_squared::(self: Self) -> T {
        return self.x * self.x + self.y * self.y +
               self.z * self.z + self.w * self.w;
    }

    distance_squared::(self: Self, other: Self) -> T {
        dx := self.x - other.x;
        dy := self.y - other.y;
        dz := self.z - other.z;
        dw := self.w - other.w;
        return dx * dx + dy * dy + dz * dz + dw * dw;
    }

    // Available when this concrete vector specialization supports floating sqrt/division.
    length::(self: Self) -> T {
        return sqrt(self.length_squared());
    }

    // Available when this concrete vector specialization supports floating sqrt/division.
    distance::(self: Self, other: Self) -> T {
        return sqrt(self.distance_squared(other));
    }

    // Requires a non-zero vector. Available for floating vector specializations.
    normalized::(self: Self) -> Self {
        magnitude := self.length();
        return self.scale(1.0 / magnitude);
    }

    min::(self: Self, other: Self) -> Self {
        return Self {
            x = min(self.x, other.x),
            y = min(self.y, other.y),
            z = min(self.z, other.z),
            w = min(self.w, other.w)
        };
    }

    max::(self: Self, other: Self) -> Self {
        return Self {
            x = max(self.x, other.x),
            y = max(self.y, other.y),
            z = max(self.z, other.z),
            w = max(self.w, other.w)
        };
    }

    clamp::(self: Self, low: Self, high: Self) -> Self {
        return Self {
            x = clamp(self.x, low.x, high.x),
            y = clamp(self.y, low.y, high.y),
            z = clamp(self.z, low.z, high.z),
            w = clamp(self.w, low.w, high.w)
        };
    }

    operators {
        + = add;
        - = sub;
        * = scale;
        / = divide;
        unary - = neg;
    }
}

// Floating game-math aggregates. Matrices use mRC element names with column-vector
// transforms: result = matrix * vector. Therefore A * B applies B first, then A.
// Storage/ABI layout is not promised to match any graphics API or SIMD type.

export Quat::<T: floating> struct {
    x: T;
    y: T;
    z: T;
    w: T;

    new::(x: T, y: T, z: T, w: T) -> Self {
        return Self { x = x, y = y, z = z, w = w };
    }

    identity::() -> Self {
        return Self { x = 0.0, y = 0.0, z = 0.0, w = 1.0 };
    }

    from_axis_angle::(axis: Vec3::<T>, angle: T) -> Self {
        unit_axis := axis.normalized();
        half_angle := angle * 0.5;
        sine := sin(half_angle);
        cosine := cos(half_angle);
        return Self {
            x = unit_axis.x * sine,
            y = unit_axis.y * sine,
            z = unit_axis.z * sine,
            w = cosine
        };
    }

    add::(self: Self, other: Self) -> Self {
        return Self {
            x = self.x + other.x,
            y = self.y + other.y,
            z = self.z + other.z,
            w = self.w + other.w
        };
    }

    neg::(self: Self) -> Self {
        return Self { x = -self.x, y = -self.y, z = -self.z, w = -self.w };
    }

    scale::(self: Self, scalar: T) -> Self {
        return Self {
            x = self.x * scalar,
            y = self.y * scalar,
            z = self.z * scalar,
            w = self.w * scalar
        };
    }

    dot::(self: Self, other: Self) -> T {
        return self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w;
    }

    length_squared::(self: Self) -> T {
        return self.dot(self);
    }

    length::(self: Self) -> T {
        return sqrt(self.length_squared());
    }

    // Requires a non-zero quaternion.
    normalized::(self: Self) -> Self {
        return self.scale(1.0 / self.length());
    }

    conjugate::(self: Self) -> Self {
        return Self { x = -self.x, y = -self.y, z = -self.z, w = self.w };
    }

    // Requires a non-zero quaternion.
    inverse::(self: Self) -> Self {
        return self.conjugate().scale(1.0 / self.length_squared());
    }

    // Hamilton product. self * other applies other first, then self when used
    // for unit-quaternion vector rotations.
    multiply::(self: Self, other: Self) -> Self {
        return Self {
            x = self.w * other.x + self.x * other.w + self.y * other.z - self.z * other.y,
            y = self.w * other.y - self.x * other.z + self.y * other.w + self.z * other.x,
            z = self.w * other.z + self.x * other.y - self.y * other.x + self.z * other.w,
            w = self.w * other.w - self.x * other.x - self.y * other.y - self.z * other.z
        };
    }

    // Requires a normalized quaternion for a pure rotation.
    rotate_vector::(self: Self, value: Vec3::<T>) -> Vec3::<T> {
        qv := Vec3::<T>.new(self.x, self.y, self.z);
        twice_cross := qv.cross(value).scale(2.0);
        return value.add(twice_cross.scale(self.w)).add(qv.cross(twice_cross));
    }

    // Spherical interpolation along the shortest arc. t is not clamped.
    // Inputs should be normalized quaternions.
    slerp::(self: Self, other: Self, t: T) -> Self {
        end := other;
        cosine := self.dot(end);

        if cosine < 0.0 {
            end = end.neg();
            cosine = -cosine;
        }

        if cosine < -1.0
            cosine = -1.0;
        if cosine > 1.0
            cosine = 1.0;

        if cosine > 0.9995 {
            return self.scale(1.0 - t).add(end.scale(t)).normalized();
        }

        theta := acos(cosine);
        sine_theta := sin(theta);
        left_weight := sin((1.0 - t) * theta) / sine_theta;
        right_weight := sin(t * theta) / sine_theta;
        return self.scale(left_weight).add(end.scale(right_weight));
    }

    operators {
        * = multiply;
        unary - = neg;
    }
}

export Mat3::<T: floating> struct {
    m00: T; m01: T; m02: T;
    m10: T; m11: T; m12: T;
    m20: T; m21: T; m22: T;

    identity::() -> Self {
        return Self {
            m00 = 1.0, m01 = 0.0, m02 = 0.0,
            m10 = 0.0, m11 = 1.0, m12 = 0.0,
            m20 = 0.0, m21 = 0.0, m22 = 1.0
        };
    }

    zero::() -> Self {
        return Self {
            m00 = 0.0, m01 = 0.0, m02 = 0.0,
            m10 = 0.0, m11 = 0.0, m12 = 0.0,
            m20 = 0.0, m21 = 0.0, m22 = 0.0
        };
    }

    from_rows::(r0: Vec3::<T>, r1: Vec3::<T>, r2: Vec3::<T>) -> Self {
        return Self {
            m00 = r0.x, m01 = r0.y, m02 = r0.z,
            m10 = r1.x, m11 = r1.y, m12 = r1.z,
            m20 = r2.x, m21 = r2.y, m22 = r2.z
        };
    }

    scaling::(amount: Vec3::<T>) -> Self {
        return Self {
            m00 = amount.x, m01 = 0.0,     m02 = 0.0,
            m10 = 0.0,     m11 = amount.y, m12 = 0.0,
            m20 = 0.0,     m21 = 0.0,     m22 = amount.z
        };
    }

    rotation_x::(angle: T) -> Self {
        c := cos(angle);
        s := sin(angle);
        return Self {
            m00 = 1.0, m01 = 0.0, m02 = 0.0,
            m10 = 0.0, m11 = c,   m12 = -s,
            m20 = 0.0, m21 = s,   m22 = c
        };
    }

    rotation_y::(angle: T) -> Self {
        c := cos(angle);
        s := sin(angle);
        return Self {
            m00 = c,   m01 = 0.0, m02 = s,
            m10 = 0.0, m11 = 1.0, m12 = 0.0,
            m20 = -s,  m21 = 0.0, m22 = c
        };
    }

    rotation_z::(angle: T) -> Self {
        c := cos(angle);
        s := sin(angle);
        return Self {
            m00 = c,   m01 = -s,  m02 = 0.0,
            m10 = s,   m11 = c,   m12 = 0.0,
            m20 = 0.0, m21 = 0.0, m22 = 1.0
        };
    }

    from_quat::(rotation: Quat::<T>) -> Self {
        q := rotation.normalized();
        xx := q.x * q.x;
        yy := q.y * q.y;
        zz := q.z * q.z;
        xy := q.x * q.y;
        xz := q.x * q.z;
        yz := q.y * q.z;
        wx := q.w * q.x;
        wy := q.w * q.y;
        wz := q.w * q.z;

        return Self {
            m00 = 1.0 - 2.0 * (yy + zz),
            m01 = 2.0 * (xy - wz),
            m02 = 2.0 * (xz + wy),
            m10 = 2.0 * (xy + wz),
            m11 = 1.0 - 2.0 * (xx + zz),
            m12 = 2.0 * (yz - wx),
            m20 = 2.0 * (xz - wy),
            m21 = 2.0 * (yz + wx),
            m22 = 1.0 - 2.0 * (xx + yy)
        };
    }

    transpose::(self: Self) -> Self {
        return Self {
            m00 = self.m00, m01 = self.m10, m02 = self.m20,
            m10 = self.m01, m11 = self.m11, m12 = self.m21,
            m20 = self.m02, m21 = self.m12, m22 = self.m22
        };
    }

    determinant::(self: Self) -> T {
        return self.m00 * (self.m11 * self.m22 - self.m12 * self.m21)
             - self.m01 * (self.m10 * self.m22 - self.m12 * self.m20)
             + self.m02 * (self.m10 * self.m21 - self.m11 * self.m20);
    }

    multiply::(self: Self, other: Self) -> Self {
        return Self {
            m00 = self.m00*other.m00 + self.m01*other.m10 + self.m02*other.m20,
            m01 = self.m00*other.m01 + self.m01*other.m11 + self.m02*other.m21,
            m02 = self.m00*other.m02 + self.m01*other.m12 + self.m02*other.m22,
            m10 = self.m10*other.m00 + self.m11*other.m10 + self.m12*other.m20,
            m11 = self.m10*other.m01 + self.m11*other.m11 + self.m12*other.m21,
            m12 = self.m10*other.m02 + self.m11*other.m12 + self.m12*other.m22,
            m20 = self.m20*other.m00 + self.m21*other.m10 + self.m22*other.m20,
            m21 = self.m20*other.m01 + self.m21*other.m11 + self.m22*other.m21,
            m22 = self.m20*other.m02 + self.m21*other.m12 + self.m22*other.m22
        };
    }

    transform_vector::(self: Self, value: Vec3::<T>) -> Vec3::<T> {
        return Vec3::<T> {
            x = self.m00*value.x + self.m01*value.y + self.m02*value.z,
            y = self.m10*value.x + self.m11*value.y + self.m12*value.z,
            z = self.m20*value.x + self.m21*value.y + self.m22*value.z
        };
    }

    operators {
        * = multiply;
    }
}

export Mat4::<T: floating> struct {
    m00: T; m01: T; m02: T; m03: T;
    m10: T; m11: T; m12: T; m13: T;
    m20: T; m21: T; m22: T; m23: T;
    m30: T; m31: T; m32: T; m33: T;

    identity::() -> Self {
        return Self {
            m00 = 1.0, m01 = 0.0, m02 = 0.0, m03 = 0.0,
            m10 = 0.0, m11 = 1.0, m12 = 0.0, m13 = 0.0,
            m20 = 0.0, m21 = 0.0, m22 = 1.0, m23 = 0.0,
            m30 = 0.0, m31 = 0.0, m32 = 0.0, m33 = 1.0
        };
    }

    zero::() -> Self {
        return Self {
            m00 = 0.0, m01 = 0.0, m02 = 0.0, m03 = 0.0,
            m10 = 0.0, m11 = 0.0, m12 = 0.0, m13 = 0.0,
            m20 = 0.0, m21 = 0.0, m22 = 0.0, m23 = 0.0,
            m30 = 0.0, m31 = 0.0, m32 = 0.0, m33 = 0.0
        };
    }

    translation::(offset: Vec3::<T>) -> Self {
        return Self {
            m00 = 1.0, m01 = 0.0, m02 = 0.0, m03 = offset.x,
            m10 = 0.0, m11 = 1.0, m12 = 0.0, m13 = offset.y,
            m20 = 0.0, m21 = 0.0, m22 = 1.0, m23 = offset.z,
            m30 = 0.0, m31 = 0.0, m32 = 0.0, m33 = 1.0
        };
    }

    scaling::(amount: Vec3::<T>) -> Self {
        return Self {
            m00 = amount.x, m01 = 0.0,     m02 = 0.0,     m03 = 0.0,
            m10 = 0.0,     m11 = amount.y, m12 = 0.0,     m13 = 0.0,
            m20 = 0.0,     m21 = 0.0,     m22 = amount.z, m23 = 0.0,
            m30 = 0.0,     m31 = 0.0,     m32 = 0.0,     m33 = 1.0
        };
    }

    rotation_x::(angle: T) -> Self {
        c := cos(angle);
        s := sin(angle);
        return Self {
            m00 = 1.0, m01 = 0.0, m02 = 0.0, m03 = 0.0,
            m10 = 0.0, m11 = c,   m12 = -s,  m13 = 0.0,
            m20 = 0.0, m21 = s,   m22 = c,   m23 = 0.0,
            m30 = 0.0, m31 = 0.0, m32 = 0.0, m33 = 1.0
        };
    }

    rotation_y::(angle: T) -> Self {
        c := cos(angle);
        s := sin(angle);
        return Self {
            m00 = c,   m01 = 0.0, m02 = s,   m03 = 0.0,
            m10 = 0.0, m11 = 1.0, m12 = 0.0, m13 = 0.0,
            m20 = -s,  m21 = 0.0, m22 = c,   m23 = 0.0,
            m30 = 0.0, m31 = 0.0, m32 = 0.0, m33 = 1.0
        };
    }

    rotation_z::(angle: T) -> Self {
        c := cos(angle);
        s := sin(angle);
        return Self {
            m00 = c,   m01 = -s,  m02 = 0.0, m03 = 0.0,
            m10 = s,   m11 = c,   m12 = 0.0, m13 = 0.0,
            m20 = 0.0, m21 = 0.0, m22 = 1.0, m23 = 0.0,
            m30 = 0.0, m31 = 0.0, m32 = 0.0, m33 = 1.0
        };
    }

    from_quat::(rotation: Quat::<T>) -> Self {
        r := Mat3::<T>.from_quat(rotation);
        return Self {
            m00 = r.m00, m01 = r.m01, m02 = r.m02, m03 = 0.0,
            m10 = r.m10, m11 = r.m11, m12 = r.m12, m13 = 0.0,
            m20 = r.m20, m21 = r.m21, m22 = r.m22, m23 = 0.0,
            m30 = 0.0,   m31 = 0.0,   m32 = 0.0,   m33 = 1.0
        };
    }

    from_trs::(position: Vec3::<T>, rotation: Quat::<T>, scale_amount: Vec3::<T>) -> Self {
        return Self.translation(position) * Self.from_quat(rotation) * Self.scaling(scale_amount);
    }

    transpose::(self: Self) -> Self {
        return Self {
            m00 = self.m00, m01 = self.m10, m02 = self.m20, m03 = self.m30,
            m10 = self.m01, m11 = self.m11, m12 = self.m21, m13 = self.m31,
            m20 = self.m02, m21 = self.m12, m22 = self.m22, m23 = self.m32,
            m30 = self.m03, m31 = self.m13, m32 = self.m23, m33 = self.m33
        };
    }

    multiply::(self: Self, other: Self) -> Self {
        return Self {
            m00 = self.m00*other.m00 + self.m01*other.m10 + self.m02*other.m20 + self.m03*other.m30,
            m01 = self.m00*other.m01 + self.m01*other.m11 + self.m02*other.m21 + self.m03*other.m31,
            m02 = self.m00*other.m02 + self.m01*other.m12 + self.m02*other.m22 + self.m03*other.m32,
            m03 = self.m00*other.m03 + self.m01*other.m13 + self.m02*other.m23 + self.m03*other.m33,
            m10 = self.m10*other.m00 + self.m11*other.m10 + self.m12*other.m20 + self.m13*other.m30,
            m11 = self.m10*other.m01 + self.m11*other.m11 + self.m12*other.m21 + self.m13*other.m31,
            m12 = self.m10*other.m02 + self.m11*other.m12 + self.m12*other.m22 + self.m13*other.m32,
            m13 = self.m10*other.m03 + self.m11*other.m13 + self.m12*other.m23 + self.m13*other.m33,
            m20 = self.m20*other.m00 + self.m21*other.m10 + self.m22*other.m20 + self.m23*other.m30,
            m21 = self.m20*other.m01 + self.m21*other.m11 + self.m22*other.m21 + self.m23*other.m31,
            m22 = self.m20*other.m02 + self.m21*other.m12 + self.m22*other.m22 + self.m23*other.m32,
            m23 = self.m20*other.m03 + self.m21*other.m13 + self.m22*other.m23 + self.m23*other.m33,
            m30 = self.m30*other.m00 + self.m31*other.m10 + self.m32*other.m20 + self.m33*other.m30,
            m31 = self.m30*other.m01 + self.m31*other.m11 + self.m32*other.m21 + self.m33*other.m31,
            m32 = self.m30*other.m02 + self.m31*other.m12 + self.m32*other.m22 + self.m33*other.m32,
            m33 = self.m30*other.m03 + self.m31*other.m13 + self.m32*other.m23 + self.m33*other.m33
        };
    }

    transform_point::(self: Self, value: Vec3::<T>) -> Vec3::<T> {
        x := self.m00*value.x + self.m01*value.y + self.m02*value.z + self.m03;
        y := self.m10*value.x + self.m11*value.y + self.m12*value.z + self.m13;
        z := self.m20*value.x + self.m21*value.y + self.m22*value.z + self.m23;
        return Vec3::<T>.new(x, y, z);
    }

    transform_vector::(self: Self, value: Vec3::<T>) -> Vec3::<T> {
        return Vec3::<T> {
            x = self.m00*value.x + self.m01*value.y + self.m02*value.z,
            y = self.m10*value.x + self.m11*value.y + self.m12*value.z,
            z = self.m20*value.x + self.m21*value.y + self.m22*value.z
        };
    }

    operators {
        * = multiply;
    }
}

// Runtime-backed floating-point math. Public functions overload only by exact
// concrete parameter types. The precision-specific runtime ABI remains private.

#extern(c, name="coglet_rt_math_sqrt_f32")
sqrt_f32::(value: f32) -> f32;
#extern(c, name="coglet_rt_math_sqrt_f64")
sqrt_f64::(value: f64) -> f64;

export sqrt::(value: f32) -> f32 { return sqrt_f32(value); }
export sqrt::(value: f64) -> f64 { return sqrt_f64(value); }

#extern(c, name="coglet_rt_math_sin_f32")
sin_f32::(value: f32) -> f32;
#extern(c, name="coglet_rt_math_sin_f64")
sin_f64::(value: f64) -> f64;

export sin::(value: f32) -> f32 { return sin_f32(value); }
export sin::(value: f64) -> f64 { return sin_f64(value); }

#extern(c, name="coglet_rt_math_cos_f32")
cos_f32::(value: f32) -> f32;
#extern(c, name="coglet_rt_math_cos_f64")
cos_f64::(value: f64) -> f64;

export cos::(value: f32) -> f32 { return cos_f32(value); }
export cos::(value: f64) -> f64 { return cos_f64(value); }

#extern(c, name="coglet_rt_math_tan_f32")
tan_f32::(value: f32) -> f32;
#extern(c, name="coglet_rt_math_tan_f64")
tan_f64::(value: f64) -> f64;

export tan::(value: f32) -> f32 { return tan_f32(value); }
export tan::(value: f64) -> f64 { return tan_f64(value); }

#extern(c, name="coglet_rt_math_asin_f32")
asin_f32::(value: f32) -> f32;
#extern(c, name="coglet_rt_math_asin_f64")
asin_f64::(value: f64) -> f64;

export asin::(value: f32) -> f32 { return asin_f32(value); }
export asin::(value: f64) -> f64 { return asin_f64(value); }

#extern(c, name="coglet_rt_math_acos_f32")
acos_f32::(value: f32) -> f32;
#extern(c, name="coglet_rt_math_acos_f64")
acos_f64::(value: f64) -> f64;

export acos::(value: f32) -> f32 { return acos_f32(value); }
export acos::(value: f64) -> f64 { return acos_f64(value); }

#extern(c, name="coglet_rt_math_atan_f32")
atan_f32::(value: f32) -> f32;
#extern(c, name="coglet_rt_math_atan_f64")
atan_f64::(value: f64) -> f64;

export atan::(value: f32) -> f32 { return atan_f32(value); }
export atan::(value: f64) -> f64 { return atan_f64(value); }

#extern(c, name="coglet_rt_math_atan2_f32")
atan2_f32::(y: f32, x: f32) -> f32;
#extern(c, name="coglet_rt_math_atan2_f64")
atan2_f64::(y: f64, x: f64) -> f64;

export atan2::(y: f32, x: f32) -> f32 { return atan2_f32(y, x); }
export atan2::(y: f64, x: f64) -> f64 { return atan2_f64(y, x); }

#extern(c, name="coglet_rt_math_floor_f32")
floor_f32::(value: f32) -> f32;
#extern(c, name="coglet_rt_math_floor_f64")
floor_f64::(value: f64) -> f64;

export floor::(value: f32) -> f32 { return floor_f32(value); }
export floor::(value: f64) -> f64 { return floor_f64(value); }

#extern(c, name="coglet_rt_math_ceil_f32")
ceil_f32::(value: f32) -> f32;
#extern(c, name="coglet_rt_math_ceil_f64")
ceil_f64::(value: f64) -> f64;

export ceil::(value: f32) -> f32 { return ceil_f32(value); }
export ceil::(value: f64) -> f64 { return ceil_f64(value); }

#extern(c, name="coglet_rt_math_round_f32")
round_f32::(value: f32) -> f32;
#extern(c, name="coglet_rt_math_round_f64")
round_f64::(value: f64) -> f64;

export round::(value: f32) -> f32 { return round_f32(value); }
export round::(value: f64) -> f64 { return round_f64(value); }

#extern(c, name="coglet_rt_math_trunc_f32")
trunc_f32::(value: f32) -> f32;
#extern(c, name="coglet_rt_math_trunc_f64")
trunc_f64::(value: f64) -> f64;

export trunc::(value: f32) -> f32 { return trunc_f32(value); }
export trunc::(value: f64) -> f64 { return trunc_f64(value); }

#extern(c, name="coglet_rt_math_fmod_f32")
fmod_f32::(x: f32, y: f32) -> f32;
#extern(c, name="coglet_rt_math_fmod_f64")
fmod_f64::(x: f64, y: f64) -> f64;

export fmod::(x: f32, y: f32) -> f32 { return fmod_f32(x, y); }
export fmod::(x: f64, y: f64) -> f64 { return fmod_f64(x, y); }

export gcd_u64::(a: u64, b: u64) -> u64 {
    left := a;
    right := b;

    while right != 0 {
        remainder := left % right;
        left = right;
        right = remainder;
    }

    return left;
}

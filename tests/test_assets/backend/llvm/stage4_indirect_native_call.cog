increment::(value: s32) -> s32 {
    return value + 1;
}

decrement::(value: s32) -> s32 {
    return value - 1;
}

choose_and_call::(use_increment: bool, value: s32) -> s32 {
    callback := decrement;
    if use_increment {
        callback = increment;
    }
    return callback(value);
}

main::() -> s32 {
    return choose_and_call(true, 41);
}

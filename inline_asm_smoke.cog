import std.io;

main::() -> s32 {
    std.io.println("=== inline asm smoke test ===");

    value: s64 = 41;
    value_2: s64 = 6;
    result: s64 = 0;

    std.io.print("input: ");
    std.io.print_s64(value);
    std.io.newline();

    asm volatile ("movq %1, %0" : "=r"(result) : "r"(value));

    std.io.print("asm output 1: ");
    std.io.print_s64(result);
    std.io.newline();

    if (result != value) {
        std.io.println("FAIL");
        return 1;
    }

    asm volatile ("incq %0" : "+r"(value));

    std.io.print("asm output 2: ");
        std.io.print_s64(value);
        std.io.newline();

    if (value != 42) {
        std.io.println("FAIL");
        return 1;
    }

result = 0;

    asm volatile (
       "movq %1, %0\n\taddq %2, %0"
        : "=r"(result)
        : "r"(value), "r"(value_2));

     std.io.print("asm output 3: ");
        std.io.print_s64(result);
        std.io.newline();

    if (result != 48) {
        std.io.println("FAIL: ");
        std.io.print_s64(value);
        std.io.newline();
        return 1;
    }

    std.io.println("PASS");
    return 0;
}

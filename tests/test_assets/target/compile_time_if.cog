main::() -> s32 {
#if target.arch == arch.x86_64
    #if target.os == os.linux
        return 42;
    #else
        return 43;
    #endif
#elif target.arch == arch.aarch64
    #if target.os == os.linux
        return 52;
    #else
        return 53;
    #endif
#else
    missing_function();
    return 99;
#endif
}

compile_time_return::() -> s32 {
#if target.arch == target.arch
    return 61;
#endif
}

compile_time_layout::() -> s32 {
#if size_of(usize) == size_of(opaque*)
    return 62;
#else
    return 63;
#endif
}

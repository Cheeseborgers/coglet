readonly_pointer_compatibility::(
    mutable: s32*,
    view: readonly s32*
) -> void {
    /*
     * Explicitly dropping write access is valid.
     */
    explicit_view: readonly s32* =
        cast(readonly s32*, mutable);

    /*
     * Access permission does not affect address equality.
     */
    mutable == view;
    view == mutable;

    mutable != view;
    view != mutable;

    explicit_view == mutable;

    /*
     * Null comparisons support either pointer access mode.
     */
    mutable == null;
    null == mutable;

    view != null;
    null != view;

    /*
     * Explicit null casts support either pointer type.
     */
    mutable_null: s32* =
        cast(s32*, null);

    readonly_null: readonly s32* =
        cast(readonly s32*, null);
}

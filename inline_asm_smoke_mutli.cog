import std.io;

main::() -> s32 {
    std.io.println("=== inline asm arithmetic smoke test ===");

    a: s64 = 20;
    b: s64 = 22;
    result: s64 = 0;

    std.io.print("a: ");
    std.io.print_s64(a);
    std.io.newline();

    std.io.print("b: ");
    std.io.print_s64(b);
    std.io.newline();

    /*
     * Put a in RDI and b in RSI, then perform the
     * arithmetic in RAX:
     *
     *     RAX = RDI + RSI
     */

    asm volatile (
        "movq %1, %0\n\taddq %2, %0"
        : "={rax}"(result)
        : "{rdi}"(a), "{rsi}"(b)
    );

    std.io.print("a + b from asm: ");
    std.io.print_s64(result);
    std.io.newline();

    if (result != 42) {
        std.io.println("FAIL: expected 42");
        return 1;
    }

    /*
     * Now exercise the read/write operand path.
     *
     *     result = result + 1
     */
    asm volatile (
        "incq %0"
        : "+r"(result)
    );

    std.io.print("after incq: ");
    std.io.print_s64(result);
    std.io.newline();

    if (result != 43) {
        std.io.println("FAIL: expected 43");
        return 1;
    }

    std.io.println("PASS");
    return 0;
}

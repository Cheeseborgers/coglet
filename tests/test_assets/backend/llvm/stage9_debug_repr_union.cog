#repr(c)
BackendValue::union {
    integer: c_int;
    real: c_double;
    flag: c_bool;
    point: BackendUnionPoint;
}

#repr(c)
BackendUnionPoint::struct {
    x: c_int;
    y: c_double;
}

#repr(c)
BackendUnionPacket::struct {
    tag: c_int;
    value: BackendValue;
    history: BackendValue[2];
}

#extern(c)
coglet_backend_make_union_packet::(value: c_int) -> BackendUnionPacket;

#extern(c)
coglet_backend_union_packet_probe::(packet: BackendUnionPacket) -> c_int;

main::() -> s32 {
    packet := coglet_backend_make_union_packet(71);
    return coglet_backend_union_packet_probe(packet);
}

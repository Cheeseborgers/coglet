Vec::struct {
    x: s32;

    add::(self: Self, other: Self) -> Self {
        return Self { x = self.x + other.x };
    }

    scale::(self: Self, scalar: s32) -> Self {
        return Self { x = self.x * scalar };
    }

    neg::(self: Self) -> Self {
        return Self { x = -self.x };
    }

    operators {
        + = add;
        * = scale;
        unary - = neg;
    }
}

import std.array as array;
import std.mem as mem;

#repr(c, align=32)
Aligned::struct {
    value: c_ulonglong;
}

main::() -> s32 {
    heap := mem.heap();

    raw := mem.alloc::<s32>(heap, 3);
    raw[0] = 7;
    raw[1] = 8;
    raw[2] = 9;
    view := slice(raw, 3);
    if view.len != 3 || view[1] != 8 {
        mem.free(heap, raw, 3);
        return 1;
    }
    mem.free(heap, raw, 3);

    values := array.Array::<s32>.new(heap);
    defer values.deinit();
    values.push(10);
    values.push(20);
    values.push(30);
    if values.len != 3 || values.capacity < 3
        return 2;
    mutable := values.as_slice();
    mutable[1] = 25;
    if values.data[1] != 25
        return 3;
    if values.pop() != 30 || values.len != 2
        return 4;

    aligned := mem.alloc::<Aligned>(heap, 2);
    aligned[0].value = 11;
    aligned[1].value = 22;
    if aligned[1].value != 22 {
        mem.free(heap, aligned, 2);
        return 5;
    }
    mem.free(heap, aligned, 2);

    arena := mem.Arena.new(heap, 128);
    defer arena.deinit();
    arena_alloc := arena.allocator();

    temp := array.Array::<s32>.new(arena_alloc);
    // deinit is valid but individual arena frees are no-ops.
    defer temp.deinit();
    for (i: s32 = 0; i < 100; i++)
        temp.push(i);
    if temp.len != 100 || temp.data[99] != 99
        return 6;

    arena.reset();
    after_reset := mem.alloc::<s32>(arena_alloc, 4);
    after_reset[0] = 42;
    if after_reset[0] != 42
        return 7;

    return 0;
}

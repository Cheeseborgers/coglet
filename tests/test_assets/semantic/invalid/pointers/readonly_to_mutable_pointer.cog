requires_mutable::(
    pointer: s32*
) -> void {
}

return_mutable::(
    pointer: readonly s32*
) -> s32* {
    return pointer;
}

readonly_to_mutable_is_invalid::(
    view: readonly s32*
) -> void {
    mutable: s32* = view;

    other: s32* = null;
    other = view;

    requires_mutable(view);
}

module target(pointer=64)
func @f0 "choose_i8"(%0: bool) -> i8 [abi=coglet, linkage=internal] {
  slots:
    $s0 : bool "flag"
  bb0 "entry"():
    %1 = local_addr $s0
    store %1, %0
    %2 = local_addr $s0
    %3 = load %2
    cond_br %3, bb1(), bb2()
  bb1 "if.then"():
    %4 = const i8 @c0(0x1)

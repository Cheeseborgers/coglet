BASE :: 40 + 2;
WIDE: s64 : 7;
FROM_INT: f32 : 3;
FROM_FLOAT: f32 : 1.25;
NEGATIVE :: -5;
NONE: s32* : null;

Mode :: enum(u8) {
    Zero,
    Seven = 7,
    Eight,
}

exercise_constants::(runtime: s32) -> s64 {
    local: s64 = BASE;

    switch runtime {
        case BASE:
            return WIDE;
        default:
            return local;
    }
}

module std.math;

// Adaptable floating-point constants. Context chooses f32 or f64.
export pi         :: 0x1.921fb54442d18p+1;
export tau        :: 0x1.921fb54442d18p+2;
export e          :: 0x1.5bf0a8b145769p+1;
export half_pi    :: 0x1.921fb54442d18p+0;
export quarter_pi :: 0x1.921fb54442d18p-1;
export inv_pi     :: 0x1.45f306dc9c883p-2;
export inv_tau    :: 0x1.45f306dc9c883p-3;
export sqrt_2     :: 0x1.6a09e667f3bcdp+0;
export deg_to_rad :: 0x1.1df46a2529d39p-6;
export rad_to_deg :: 0x1.ca5dc1a63c1f8p+5;

export eps           :: 2.2204460492503131e-16;  // machine epsilon for f64
export eps_f32       :: 1.1920928955078125e-7;   // machine epsilon for f32
export max_f32       :: 3.4028234663852886e+38;
export min_f32       :: 1.1754943508222875e-38;
export max_f64       :: 1.7976931348623157e+308;
export min_f64       :: 2.2250738585072014e-308;
export infinity      :: 1.0 / 0.0;
export nan           :: 0.0 / 0.0;

// Common angles in radians
export rad_0         :: 0.0;
export rad_30        :: 0.5235987755982988;
export rad_45        :: 0.7853981633974483;
export rad_60        :: 1.0471975511965976;
export rad_90        :: 1.5707963267948966;
export rad_120       :: 2.0943951023931953;
export rad_180       :: 3.141592653589793;
export rad_270       :: 4.71238898038469;
export rad_360       :: 6.283185307179586;

// Integer utilities
export is_power_of_two::(value: u64) -> bool {
    return value != 0 && (value & (value - 1)) == 0;
}

export next_power_of_two::(value: u64) -> u64 {
    if value == 0
        return 1;
    result := value - 1;
    result |= result >> 1;
    result |= result >> 2;
    result |= result >> 4;
    result |= result >> 8;
    result |= result >> 16;
    result |= result >> 32;
    return result + 1;
}

export align_up::(value: u64, alignment: u64) -> u64 {
    return (value + alignment - 1) & ~(alignment - 1);
}

// Sign/absolute
export abs::<T: numeric>(value: T) -> T {
    if value < 0
        return -value;
    return value;
}

export sign::<T: numeric>(value: T) -> T {
    if value > 0
        return 1;
    if value < 0
        return -1;
    return 0;
}

export min::<T: ordered>(a: T, b: T) -> T {
    if a < b
        return a;

    return b;
}

export max::<T: ordered>(a: T, b: T) -> T {
    if a > b
        return a;

    return b;
}

// Requires low <= high.
export clamp::<T: ordered>(value: T, low: T, high: T) -> T {
    if value < low
        return low;

    if value > high
        return high;

    return value;
}

export clamp01::<T: floating>(value: T) -> T {
    if value < 0.0
        return 0.0;

    if value > 1.0
        return 1.0;

    return value;
}

// Linear interpolation. t is not clamped, so values outside [0, 1] extrapolate.
export lerp::<T: floating>(a: T, b: T, t: T) -> T {
    return a + (b - a) * t;
}

// Requires a != b.
export inverse_lerp::<T: floating>(a: T, b: T, value: T) -> T {
    return (value - a) / (b - a);
}

export lerp_angle::<T: floating>(from: T, to: T, t: T) -> T {
    diff := fmod(to - from, tau);
    if diff > pi
        diff = diff - tau;
    if diff < -pi
        diff = diff + tau;
    return from + diff * t;
}

// Requires in_min != in_max. The result is not clamped to the output range.
export remap::<T: floating>(in_min: T, in_max: T, out_min: T, out_max: T, value: T) -> T {
    t := inverse_lerp(in_min, in_max, value);
    return lerp(out_min, out_max, t);
}

export hermite::<T: floating>(t: T) -> T {
    return t * t * (3.0 - 2.0 * t);
}

export quintic::<T: floating>(t: T) -> T {
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

// Cubic Hermite interpolation from 0 to 1. Requires edge0 < edge1.
export smoothstep::<T: floating>(edge0: T, edge1: T, value: T) -> T {
    t := clamp01((value - edge0) / (edge1 - edge0));
    return hermite(t);
}

export smoothstep_derivative::<T: floating>(t: T) -> T {
    return 6.0 * t * (1.0 - t);
}

export to_radians::<T: floating>(degrees: T) -> T {
    return degrees * deg_to_rad;
}

export to_degrees::<T: floating>(radians: T) -> T {
    return radians * rad_to_deg;
}

#extern(c, name="coglet_rt_math_sqrt_f32")
sqrt_f32::(value: f32) -> f32;
#extern(c, name="coglet_rt_math_sqrt_f64")
sqrt_f64::(value: f64) -> f64;

export sqrt::(value: f32) -> f32 { return sqrt_f32(value); }
export sqrt::(value: f64) -> f64 { return sqrt_f64(value); }

#extern(c, name="coglet_rt_math_sin_f32")
sin_f32::(value: f32) -> f32;
#extern(c, name="coglet_rt_math_sin_f64")
sin_f64::(value: f64) -> f64;

export sin::(value: f32) -> f32 { return sin_f32(value); }
export sin::(value: f64) -> f64 { return sin_f64(value); }

#extern(c, name="coglet_rt_math_cos_f32")
cos_f32::(value: f32) -> f32;
#extern(c, name="coglet_rt_math_cos_f64")
cos_f64::(value: f64) -> f64;

export cos::(value: f32) -> f32 { return cos_f32(value); }
export cos::(value: f64) -> f64 { return cos_f64(value); }


sum_ints::<...Args: integer>(args: ...Args) -> s32 {
    sum := 0;
    for (arg in args) {
        sum += cast(s32, arg);
    }
    return sum;
}

count_args::<...Args>(args: ...Args) -> usize {
    count: usize = 0;
    for (arg in args) {
        count += 1;
    }
    return count;
}

main::() -> s32 {
    a := sum_ints(1, 2, 3);
    b := sum_ints(cast(s64, 4), cast(s32, 5));
    c := count_args();
    d := count_args(true, 1, 2.0, "x");
    if a != 6 || b != 9 || c != 0 || d != 4
        return 1;
    return 0;
}

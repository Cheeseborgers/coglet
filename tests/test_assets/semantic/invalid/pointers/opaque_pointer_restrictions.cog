opaque_pointer_restrictions::(
    p: s32*,
    rp: readonly s32*,
    h: opaque*,
    rh: readonly opaque*
) -> void {
    direct_erasure: opaque* = p;
    direct_recovery: s32* = h;

    p == h;

    *h;
    h[0];

    reinterpret(opaque*, rp);
    reinterpret(s32*, rh);

    reinterpret(u8*, p);
    reinterpret(readonly opaque*, rh);
    reinterpret(readonly s32*, rp);
}

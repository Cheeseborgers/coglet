capture_without_inner_slots::() -> s32 {
    outer_value: s32 = 10;

    inner::() -> s32 {
        return outer_value;
    }

    return outer_value;
}

capture_with_colliding_parameter::() -> s32 {
    outer_value: s32;

    inner::(dummy: s32) -> s32 {
        return outer_value;
    }

    return 0;
}

capture_outer_parameter::(outer_value: s32) -> s32 {
    inner::() -> s32 {
        return outer_value;
    }

    return 0;
}

write_outer_local::() -> s32 {
    outer_value: s32;

    inner::() -> s32 {
        outer_value = 10;
        return 0;
    }

    return 0;
}

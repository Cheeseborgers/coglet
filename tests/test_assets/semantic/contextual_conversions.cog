#extern(c)
puts::(text: readonly c_char*) -> c_int;

#extern(c)
printf::(format: readonly c_char*, ...) -> c_int;

return_wide::() -> s64 {
    return 7;
}

exercise_contexts::(runtime: s32, pointer: s32*) -> s32 {
    inferred := 1;
    wide: s64 = 2;
    from_integer: f32 = 3;
    from_float: f32 = 1.25;

    view: readonly volatile s32* = pointer;
    empty: s32* = null;

    arithmetic := runtime + 4;
    comparison := runtime < 5;

    values: s32[2] = [6, 7];
    selected := values[1];
    mutable_slice: s32[] = values;
    readonly_slice: readonly s32[] = mutable_slice;
    selected += readonly_slice[0];

    switch runtime {
        case 8:
            arithmetic = 9;
        default:
            arithmetic = 10;
    }

    puts("ok");
    printf("%d %f\n", 11, 2.5);

    if comparison {
        return arithmetic + selected + inferred + cast(s32, wide) + cast(s32, from_integer) + cast(s32, from_float);
    }

    if view == null {
        return 0;
    }

    if empty == null {
        return 0;
    }

    return arithmetic;
}

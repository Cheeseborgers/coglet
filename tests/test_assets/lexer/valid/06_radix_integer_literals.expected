1 IDENT hex_lower
1 COLON_EQUAL :=
1 NUMBER_INT 0xff
1 SEMICOLON ;
2 IDENT hex_upper
2 COLON_EQUAL :=
2 NUMBER_INT 0XABCD
2 SEMICOLON ;
4 IDENT binary_lower
4 COLON_EQUAL :=
4 NUMBER_INT 0b1010
4 SEMICOLON ;
5 IDENT binary_upper
5 COLON_EQUAL :=
5 NUMBER_INT 0B0101
5 SEMICOLON ;
7 IDENT octal_lower
7 COLON_EQUAL :=
7 NUMBER_INT 0o755
7 SEMICOLON ;
8 IDENT octal_upper
8 COLON_EQUAL :=
8 NUMBER_INT 0O644
8 SEMICOLON ;
10 IDENT leading_zero_decimal
10 COLON_EQUAL :=
10 NUMBER_INT 0755
10 SEMICOLON ;
11 IDENT hex_with_e
11 COLON_EQUAL :=
11 NUMBER_INT 0x1e3
11 SEMICOLON ;
12 EOF

#repr(c)
ForeignHandle::struct;

#repr(c)
CNode::struct {
    value: c_int;
    next: readonly CNode*;
    handle: ForeignHandle*;
}

#repr(c)
Mode::enum(c_int) {
    Zero,
    Seven = 7,
    Eight,
}

COUNT: s64 : 42;
NEG: s16 : -2;
RATIO: f32 : 1.25;
ENABLED: bool : true;
NONE: s32* : null;
counter: s32 = 3;
c_flag: c_bool = true;
callback: cfn(c_int) -> c_int = null;
values: s32[3] = [1, 2, 3];

#extern(c, name="native_probe")
native_probe_decl::(
    node: readonly CNode*,
    mode: Mode,
    amount: c_long
) -> c_int;

helper::(x: s32) -> s32 {
    local: s32 = x;
    return local;
}

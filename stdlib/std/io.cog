module std.io;

// Minimal bootstrap I/O. Text is a readonly byte slice so callers pass an
// explicit pointer+length view rather than relying on C NUL termination.
//
// c_* types are intentionally kept inside this module. They are ABI types
// used only when crossing the C runtime boundary.

#extern(c, name="coglet_rt_io_write")
write_bytes::(data: readonly u8*, length: c_size) -> void;

export print::(text: readonly u8[]) -> void {
    write_bytes(text.data, cast(c_size, text.len));
}

export println::(text: readonly u8[]) -> void {
    write_bytes(text.data, cast(c_size, text.len));
    newline();
}

export #extern(c, name="coglet_rt_io_newline")
newline::() -> void;

export #extern(c, name="coglet_rt_io_flush")
flush::() -> void;

export #extern(c, name="coglet_rt_io_print_bool")
print_bool::(value: bool) -> void;

export #extern(c, name="coglet_rt_io_print_s8")
print_s8::(value: s8) -> void;

export #extern(c, name="coglet_rt_io_print_s16")
print_s16::(value: s16) -> void;

export #extern(c, name="coglet_rt_io_print_s32")
print_s32::(value: s32) -> void;

export #extern(c, name="coglet_rt_io_print_s64")
print_s64::(value: s64) -> void;

export #extern(c, name="coglet_rt_io_print_u8")
print_u8::(value: u8) -> void;

export #extern(c, name="coglet_rt_io_print_u16")
print_u16::(value: u16) -> void;

export #extern(c, name="coglet_rt_io_print_u32")
print_u32::(value: u32) -> void;

export #extern(c, name="coglet_rt_io_print_u64")
print_u64::(value: u64) -> void;

export #extern(c, name="coglet_rt_io_print_f32")
print_f32::(value: f32) -> void;

export #extern(c, name="coglet_rt_io_print_f64")
print_f64::(value: f64) -> void;


// -----------------------------------------------------------------------------
// File runtime ABI
// -----------------------------------------------------------------------------

#extern(c, name="coglet_rt_io_file_open_read")
file_open_read::(path: readonly u8*, length: c_size) -> opaque*;

#extern(c, name="coglet_rt_io_file_open_write")
file_open_write::(path: readonly u8*, length: c_size) -> opaque*;

#extern(c, name="coglet_rt_io_file_open_append")
file_open_append::(path: readonly u8*, length: c_size) -> opaque*;

#extern(c, name="coglet_rt_io_file_close")
file_close::(handle: opaque*) -> void;

#extern(c, name="coglet_rt_io_file_read")
file_read::(handle: opaque*, data: u8*, length: c_size) -> c_size;

#extern(c, name="coglet_rt_io_file_write")
file_write::(handle: opaque*, data: readonly u8*, length: c_size) -> c_size;

#extern(c, name="coglet_rt_io_file_flush")
file_flush::(handle: opaque*) -> bool;

#extern(c, name="coglet_rt_io_file_eof")
file_eof::(handle: opaque*) -> bool;

#extern(c, name="coglet_rt_io_file_error")
file_error::(handle: opaque*) -> bool;

#extern(c, name="coglet_rt_io_file_remove")
file_remove::(path: readonly u8*, length: c_size) -> bool;


// -----------------------------------------------------------------------------
// File positioning
// -----------------------------------------------------------------------------

export seek_begin: s32 = 0;
export seek_current: s32 = 1;
export seek_end: s32 = 2;

#extern(c, name="coglet_rt_io_file_seek")
rt_file_seek::(handle: opaque*, offset: s64, origin: s32) -> bool;

#extern(c, name="coglet_rt_io_file_tell")
rt_file_tell::(handle: opaque*) -> s64;

#extern(c, name="coglet_rt_io_file_set_buffered")
rt_file_set_buffered::(handle: opaque*, buffered: bool) -> bool;

#extern(c, name="coglet_rt_io_file_exists")
rt_file_exists::(path: readonly u8*, length: c_size) -> bool;

#extern(c, name="coglet_rt_io_file_copy")
rt_file_copy::(
    source: readonly u8*,
    source_length: c_size,
    destination: readonly u8*,
    destination_length: c_size
) -> bool;

#extern(c, name="coglet_rt_io_file_rename")
rt_file_rename::(
    source: readonly u8*,
    source_length: c_size,
    destination: readonly u8*,
    destination_length: c_size
) -> bool;


// -----------------------------------------------------------------------------
// Directory runtime ABI
// -----------------------------------------------------------------------------

#extern(c, name="coglet_rt_io_directory_create")
rt_directory_create::(path: readonly u8*, length: c_size) -> bool;

#extern(c, name="coglet_rt_io_directory_remove")
rt_directory_remove::(path: readonly u8*, length: c_size) -> bool;

#extern(c, name="coglet_rt_io_directory_open")
rt_directory_open::(path: readonly u8*, length: c_size) -> opaque*;

#extern(c, name="coglet_rt_io_directory_next")
rt_directory_next::(
    handle: opaque*,
    name: u8*,
    capacity: c_size,
    out_length: c_size*
) -> bool;

#extern(c, name="coglet_rt_io_directory_close")
rt_directory_close::(handle: opaque*) -> void;


// -----------------------------------------------------------------------------
// File
// -----------------------------------------------------------------------------

export File::resource {
    handle: opaque*;

    open_read::(path: readonly u8[]) -> Self {
        return Self {
            handle = file_open_read(
                path.data,
                cast(c_size, path.len)
            )
        };
    }

    open_write::(path: readonly u8[]) -> Self {
        return Self {
            handle = file_open_write(
                path.data,
                cast(c_size, path.len)
            )
        };
    }

    open_append::(path: readonly u8[]) -> Self {
        return Self {
            handle = file_open_append(
                path.data,
                cast(c_size, path.len)
            )
        };
    }

    is_open::(self: readonly Self*) -> bool {
        return (*self).handle != null;
    }

    read::(self: Self*, data: u8[]) -> usize {
        result := file_read(
            (*self).handle,
            data.data,
            cast(c_size, data.len)
        );

        return cast(usize, result);
    }

    write::(self: Self*, data: readonly u8[]) -> usize {
        result := file_write(
            (*self).handle,
            data.data,
            cast(c_size, data.len)
        );

        return cast(usize, result);
    }

    seek::(self: Self*, offset: s64, origin: s32) -> bool {
        return rt_file_seek((*self).handle, offset, origin);
    }

    tell::(self: readonly Self*) -> s64 {
        return rt_file_tell((*self).handle);
    }

    rewind::(self: Self*) -> bool {
        return self.seek(0, seek_begin);
    }

    set_buffered::(self: Self*, buffered: bool) -> bool {
        return rt_file_set_buffered((*self).handle, buffered);
    }

    flush::(self: Self*) -> bool {
        return file_flush((*self).handle);
    }

    eof::(self: readonly Self*) -> bool {
        return file_eof((*self).handle);
    }

    error::(self: readonly Self*) -> bool {
        return file_error((*self).handle);
    }

    close::(self: Self*) -> void {
        if ((*self).handle != null) {
            file_close((*self).handle);
            (*self).handle = null;
        }
    }

    deinit::(self: Self*) -> void {
        self.close();
    }
}


// -----------------------------------------------------------------------------
// File operations
// -----------------------------------------------------------------------------

export remove_file::(path: readonly u8[]) -> bool {
    return file_remove(
        path.data,
        cast(c_size, path.len)
    );
}

export file_exists::(path: readonly u8[]) -> bool {
    return rt_file_exists(
        path.data,
        cast(c_size, path.len)
    );
}

export copy_file::(
    source: readonly u8[],
    destination: readonly u8[]
) -> bool {
    return rt_file_copy(
        source.data,
        cast(c_size, source.len),
        destination.data,
        cast(c_size, destination.len)
    );
}

export rename_file::(
    source: readonly u8[],
    destination: readonly u8[]
) -> bool {
    return rt_file_rename(
        source.data,
        cast(c_size, source.len),
        destination.data,
        cast(c_size, destination.len)
    );
}


// -----------------------------------------------------------------------------
// Directory
// -----------------------------------------------------------------------------

export create_directory::(path: readonly u8[]) -> bool {
    return rt_directory_create(
        path.data,
        cast(c_size, path.len)
    );
}

export remove_directory::(path: readonly u8[]) -> bool {
    return rt_directory_remove(
        path.data,
        cast(c_size, path.len)
    );
}

export Directory::resource {
    handle: opaque*;

    open::(path: readonly u8[]) -> Self {
        return Self {
            handle = rt_directory_open(
                path.data,
                cast(c_size, path.len)
            )
        };
    }

    is_open::(self: readonly Self*) -> bool {
        return (*self).handle != null;
    }

    next::(
        self: Self*,
        name: u8[],
        out_length: usize*
    ) -> bool {
        length: c_size = 0;

        if (!rt_directory_next(
            (*self).handle,
            name.data,
            cast(c_size, name.len),
            &length
        )) {
            return false;
        }

        *out_length = cast(usize, length);
        return true;
    }

    close::(self: Self*) -> void {
        if ((*self).handle != null) {
            rt_directory_close((*self).handle);
            (*self).handle = null;
        }
    }

    deinit::(self: Self*) -> void {
        self.close();
    }
}

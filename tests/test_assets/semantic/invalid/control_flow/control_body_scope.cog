for_initializer_scope::() -> s32 {
    for (i: s32 = 0; i < 1; i++)
        continue;

    return i;
}

if_body_scope::(flag: bool) -> s32 {
    if flag
        value: s32 = 1;

    return value;
}

while_body_scope::(flag: bool) -> s32 {
    while flag
        value: s32 = 2;

    return value;
}

for_body_scope::(flag: bool) -> s32 {
    for flag
        value: s32 = 3;

    return value;
}

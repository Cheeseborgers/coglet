export KiB :: 1024;
export MiB :: 1024 * 1024;
export GiB :: 1024 * 1024 * 1024;
export TiB :: 1024 * 1024 * 1024 * 1024;

export bytes_to_kb::(bytes: u64) -> u64 {
    return bytes / kb;
}

export bytes_to_mb::(bytes: u64) -> u64 {
    return bytes / mb;
}

export bytes_to_gb::(bytes: u64) -> u64 {
    return bytes / gb;
}

export bytes_to_tb::(bytes: u64) -> u64 {
    return bytes / tb;
}

export kb_to_bytes::(kb_value: u64) -> u64 {
    return kb_value * kb;
}

export mb_to_bytes::(mb_value: u64) -> u64 {
    return mb_value * mb;
}

export gb_to_bytes::(gb_value: u64) -> u64 {
    return gb_value * gb;
}

export tb_to_bytes::(tb_value: u64) -> u64 {
    return tb_value * tb;
}

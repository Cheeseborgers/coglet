Point::struct {
    x: s32;
    y: s32;
}

#extern(c)
puts::(s: readonly c_char*) -> c_int;

consume_array::(a: s32[3]) -> s32[3] {
    return a;
}

consume_point::(p: Point) -> Point {
    return p;
}

volatile_io::(p: volatile s32*) -> s32 {
    *p = *p + 1;
    return *p;
}

data_address::() -> s64 {
    point := Point { x = 1, y = 2 };
    values: s32[3] = [3, 4, 5];
    name: u8[6] = "hello";
    ch: u8 = 'A';

    point.x = values[0];
    point.y += values[1];
    point.x++;

    px: s32* = &point.x;
    *px = *px + values[2];
    values[1] = point.y;
    values[2]++;

    copy: s32[3] = consume_array(values);
    copy = [7, 8, 9];
    point2: Point = consume_point(point);

    raw: opaque* = reinterpret(opaque*, px);
    px2: s32* = reinterpret(s32*, raw);
    readonly_px: readonly s32* = cast(readonly s32*, px2);

    widened: s64 = cast(s64, *readonly_px);
    narrowed: u8 = truncate(u8, widened);
    widened2: s64 = cast(s64, narrowed);

    puts("hello");

    return widened + widened2 + cast(s64, ch) + cast(s64, copy[0]) + cast(s64, point2.x) + cast(s64, name[0]);
}

operators::(
    a: s32,
    b: s32,
    c: s32,
    d: s32,
    flags: s32,
    mask: s32
) {
    precedence := a | b ^ c & d;
    shifts := a + b << c * d;
    comparison := flags & mask == 0;
    logical := a && b | c || d;
    left_shift := a << b >> c;
    left_and := a & b & c;
    complement := ~a;

    a &= b;
    a |= b;
    a ^= b;
    a <<= b;
    a >>= b;
}

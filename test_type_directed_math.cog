import std.math as math;
import std.io as io;

main::() -> s32 {
    // Normal struct construction: .new(...) is optional.
    v := math.Vec3::<f32> {
        x = 1.0,
        y = 2.0,
        z = 2.0
    };

    // Exact overload selection chooses sqrt(f32) from the f32 argument.
    root: f32 = math.sqrt(v.length_squared());
    if root != 3.0
        return 1;

    if v.length() != 3.0
        return 2;

    origin := math.Vec3::<f32>.zero();
    if v.distance(origin) != 3.0
        return 3;

    unit := v.normalized();
    if unit.x < 0.3332 || unit.x > 0.3334
        return 4;

    // Untyped floating literals default to f64, so this selects sqrt(f64).
    root64 := math.sqrt(16.0);
    if root64 != 4.0
        return 5;

    io.print("length = ");
    io.print_f32(v.length());
    io.newline();

    io.print("normal = (");
    io.print_f32(unit.x);
    io.print(", ");
    io.print_f32(unit.y);
    io.print(", ");
    io.print_f32(unit.z);
    io.println(")");

    return 0;
}

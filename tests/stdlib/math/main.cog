import std.math;

main::() -> i32 {
    if std.math.abs_i32(-42) != 42
        return 1;
    if std.math.abs_i32(17) != 17
        return 2;

    if std.math.min(10, 20) != 10
        return 3;
    if std.math.max(10, 20) != 20
        return 4;
    if std.math.min::<u64>(30, 20) != 20
        return 10;
    if std.math.max::<i64>(-30, -20) != -20
        return 11;

    if std.math.gcd_u64(84, 30) != 6
        return 5;
    if std.math.gcd_u64(0, 42) != 42
        return 6;
    if std.math.gcd_u64(42, 0) != 42
        return 7;

    pi32: f32 = std.math.pi;
    pi64: f64 = std.math.pi;
    tau32: f32 = std.math.tau;
    tau64: f64 = std.math.tau;

    if pi32 < 3.1415 || pi32 > 3.1416
        return 8;
    if pi64 < 3.1415 || pi64 > 3.1416
        return 9;
    if tau32 != pi32 * 2.0
        return 12;
    if tau64 != pi64 * 2.0
        return 13;

    return 0;
}

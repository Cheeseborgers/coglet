Box::struct {
    tag: s32;
    values: s32[3];
}

global_values: s32[3] = [4, 5, 6];
global_box: Box = Box {
    tag = 7,
    values = [8, 9, 10],
};

make_values::(base: s32) -> s32[3] {
    return [base, base + 1, base + 2];
}

sum_values::(values: s32[3]) -> s32 {
    return values[0] + values[1] + values[2];
}

make_box::(base: s32) -> Box {
    return Box {
        tag = base,
        values = [base + 1, base + 2, base + 3],
    };
}

main::() -> s32 {
    values := make_values(11);
    copy := values;
    copy[1] = 20;
    if values[1] != 12 || copy[1] != 20
        return 1;

    if sum_values(make_values(3)) != 12
        return 2;

    box := make_box(30);
    extracted := box.values;
    if box.tag != 30 || extracted[0] != 31 || extracted[2] != 33
        return 3;

    copied_box := box;
    copied_box.values[0] = 99;
    if box.values[0] != 31 || copied_box.values[0] != 99
        return 4;

    pointer: s32* = &copy[0];
    pointer[2] = 41;
    raw: opaque* = reinterpret(opaque*, pointer);
    recovered: s32* = reinterpret(s32*, raw);
    if recovered != pointer || recovered[2] != 41
        return 5;

    ro: readonly s32* = pointer;
    if ro != cast(readonly s32*, pointer)
        return 6;

    if global_values[0] != 4 || global_values[2] != 6
        return 7;
    if global_box.tag != 7 || global_box.values[1] != 9
        return 8;

    return 73;
}

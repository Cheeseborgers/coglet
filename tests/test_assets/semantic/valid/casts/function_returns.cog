cast_s32_to_s64::() -> s64 {
    small: s32 = 10;
    return cast(s64, small);
}

cast_float_to_int::() -> s32 {
    return cast(s32, 3.14);
}

Color :: enum(u16) {
    Red,
    Green,
    Blue,
}

cast_enum_to_int::() -> u16 {
    return cast(u16, Color.Green);
}

cast_int_to_enum::() -> Color {
    return cast(Color, 0);
}
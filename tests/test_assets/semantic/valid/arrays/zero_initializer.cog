Holder::struct {
    values: s32[3];
}

takes_values::(values: s32[3]) -> s32 {
    return values[0] + values[1] + values[2];
}

make_values::() -> s32[3] {
    return {0};
}

exercise::() -> s32 {
    values: s32[3] = {0};
    values[1] = 7;
    values = {0};

    holder := Holder {
        values = {0},
    };

    made := make_values();
    return takes_values({0}) + holder.values[2] + made[0];
}

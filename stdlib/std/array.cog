module std.array;

import std.mem as mem;

// Growable contiguous storage using an explicit allocator.
//
// Array<T> owns its allocation and is therefore move-only. Use `move value`
// when transferring ownership to another variable, parameter, or return.
export Array::<T: copyable> resource {
    data: T*;
    len: usize;
    capacity: usize;
    allocator: mem.Allocator;

    new::(allocator: mem.Allocator) -> Self {
        return Self {
            data = null,
            len = 0,
            capacity = 0,
            allocator = allocator
        };
    }

    with_capacity::(allocator: mem.Allocator, capacity: usize) -> Self {
        result := Self.new(allocator);
        if capacity != 0 {
            result.data = mem.alloc::<T>(allocator, capacity);
            result.capacity = capacity;
        }
        return move result;
    }

    deinit::(self: Self*) -> void {
        mem.free((*self).allocator, (*self).data, (*self).capacity);
        (*self).data = null;
        (*self).len = 0;
        (*self).capacity = 0;
    }

    is_empty::(self: readonly Self*) -> bool {
        return (*self).len == 0;
    }

    clear::(self: Self*) -> void {
        (*self).len = 0;
    }

    reserve::(self: Self*, additional: usize) -> void {
        required := (*self).len + additional;
        if required <= (*self).capacity
            return;

        next_capacity := (*self).capacity;
        if next_capacity < 8
            next_capacity = 8;

        while next_capacity < required
            next_capacity *= 2;

        (*self).data = mem.resize(
            (*self).allocator,
            (*self).data,
            (*self).capacity,
            next_capacity
        );
        (*self).capacity = next_capacity;
    }

    push::(self: Self*, value: T) -> void {
        (*self).reserve(1);
        (*self).data[(*self).len] = value;
        (*self).len += 1;
    }

    // Requires len > 0.
    pop::(self: Self*) -> T {
        (*self).len -= 1;
        return (*self).data[(*self).len];
    }

    as_slice::(self: Self*) -> T[] {
        return slice((*self).data, (*self).len);
    }

    as_readonly_slice::(self: readonly Self*) -> readonly T[] {
        data := cast(readonly T*, (*self).data);
        return slice(data, (*self).len);
    }
}

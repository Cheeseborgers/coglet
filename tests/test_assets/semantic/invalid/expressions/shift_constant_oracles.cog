LEFT_U8_ZERO: bool :
    (cast(u8, 128) << 1) == cast(u8, 0);

LEFT_S8_SIGN: bool :
    (cast(s8, 64) << 1) == cast(s8, -128);

RIGHT_U8: bool :
    (cast(u8, 128) >> 1) == cast(u8, 64);

RIGHT_S8_NEGATIVE: bool :
    (cast(s8, -3) >> 1) == cast(s8, -2);

RIGHT_S8_MIN: bool :
    (cast(s8, -128) >> 7) == cast(s8, -1);

LEFT_U64_HIGH_BIT: bool :
    (cast(u64, 1) << 63) ==
        cast(u64, 9223372036854775808);

check_left_u8::(value: bool) -> void {
    switch value {
        case LEFT_U8_ZERO: {}
        case true: {}
        default: {}
    }
}

check_left_s8::(value: bool) -> void {
    switch value {
        case LEFT_S8_SIGN: {}
        case true: {}
        default: {}
    }
}

check_right_u8::(value: bool) -> void {
    switch value {
        case RIGHT_U8: {}
        case true: {}
        default: {}
    }
}

check_right_s8_negative::(value: bool) -> void {
    switch value {
        case RIGHT_S8_NEGATIVE: {}
        case true: {}
        default: {}
    }
}

check_right_s8_min::(value: bool) -> void {
    switch value {
        case RIGHT_S8_MIN: {}
        case true: {}
        default: {}
    }
}

check_left_u64::(value: bool) -> void {
    switch value {
        case LEFT_U64_HIGH_BIT: {}
        case true: {}
        default: {}
    }
}

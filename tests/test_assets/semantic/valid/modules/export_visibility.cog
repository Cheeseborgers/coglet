module visibility_semantic;

secret :: 2;
helper::(value: s32) -> s32 { return value + secret; }

export answer :: 40;
export left, right: s32 = 0;

export Pair::struct {
    x: s32;
    y: s32;
}

export public_value::() -> s32 {
    pair := Pair { x = answer, y = helper(0) };
    left = pair.x;
    right = pair.y;
    return left + right;
}

counter: s32 = 3;
seed: s32 = 4;

add::(a: s32, b: s32) -> s32 {
    sum: s32 = a + b;
    return sum;
}

bump::(x: s32) -> s32 {
    x = x + 1;
    y: s32 = x;
    y = y + 1;
    return add(y, 2);
}

touch::(x: s32) -> void {
    local: s32 = x;
}

counter = bump(counter);
touch(seed);
add(seed, 5);

runtime_truncating_integer::(
    signed_value: s64,
    unsigned_value: u64
) -> void {
    as_u8: u8 =
        truncate(
            u8,
            signed_value
        );

    as_s8: s8 =
        truncate(
            s8,
            unsigned_value
        );

    as_u32: u32 =
        truncate(
            u32,
            signed_value
        );

    as_s32: s32 =
        truncate(
            s32,
            unsigned_value
        );
}

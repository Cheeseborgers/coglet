// std.math generic-functions smoke test
//
// Recommended location:
//   <coglet-repo>/test_math_generics.cog
//
// From the repository root:
//
//   ./coglet test_math_generics.cog --stdlib-root ./stdlib -o test_math_generics
//   ./test_math_generics
//   echo $?
//
// Exit status 0 means every check passed.

import std.math;

main::() -> i32 {
    // Generic min/max with type inference.
    if std.math.min(10, 20) != 10
        return 1;

    if std.math.max(10, 20) != 20
        return 2;

    if std.math.min(-30, -20) != -30
        return 3;

    if std.math.max(-30, -20) != -20
        return 4;

    if std.math.min(1.25, 2.5) != 1.25
        return 5;

    if std.math.max(1.25, 2.5) != 2.5
        return 6;

    // Existing concrete std.math helpers.
    if std.math.abs_i32(-42) != 42
        return 7;

    if std.math.gcd_u64(84, 30) != 6
        return 8;

    // Existing constants.
    if std.math.pi < 3.1415
        return 9;

    if std.math.pi > 3.1416
        return 10;

    return 69;
}

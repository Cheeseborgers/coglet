import std.math as math;

approx_f32::(a: f32, b: f32, epsilon: f32) -> bool {
    diff := a - b;
    if diff < 0.0
        diff = -diff;
    return diff <= epsilon;
}

approx_f64::(a: f64, b: f64, epsilon: f64) -> bool {
    diff := a - b;
    if diff < 0.0
        diff = -diff;
    return diff <= epsilon;
}

vec3_approx_f32::(a: math.Vec3::<f32>, b: math.Vec3::<f32>, epsilon: f32) -> bool {
    return approx_f32(a.x, b.x, epsilon)
        && approx_f32(a.y, b.y, epsilon)
        && approx_f32(a.z, b.z, epsilon);
}

main::() -> s32 {
    eps: f32 = 0.0002;
    x := math.Vec3::<f32>.new(1.0, 0.0, 0.0);
    y := math.Vec3::<f32>.new(0.0, 1.0, 0.0);
    zero := math.Vec3::<f32>.zero();

    identity_q := math.Quat::<f32>.identity();
    if !vec3_approx_f32(identity_q.rotate_vector(x), x, eps)
        return 1;

    qz := math.Quat::<f32>.from_axis_angle(math.Vec3::<f32>.new(0.0, 0.0, 1.0), math.half_pi);
    if !vec3_approx_f32(qz.rotate_vector(x), y, eps)
        return 2;
    if !approx_f32(qz.length(), 1.0, eps)
        return 3;

    inverse_q := qz.inverse();
    restored_q := qz * inverse_q;
    if !approx_f32(restored_q.x, 0.0, eps) ||
       !approx_f32(restored_q.y, 0.0, eps) ||
       !approx_f32(restored_q.z, 0.0, eps) ||
       !approx_f32(restored_q.w, 1.0, eps)
        return 4;

    halfway_q := identity_q.slerp(qz, 0.5);
    halfway_v := halfway_q.rotate_vector(x);
    half_sqrt2: f32 = math.sqrt_2 * 0.5;
    if !approx_f32(halfway_v.x, half_sqrt2, eps) ||
       !approx_f32(halfway_v.y, half_sqrt2, eps)
        return 5;

    m3_identity := math.Mat3::<f32>.identity();
    if !vec3_approx_f32(m3_identity.transform_vector(x), x, eps)
        return 6;

    m3_rot := math.Mat3::<f32>.rotation_z(math.half_pi);
    if !vec3_approx_f32(m3_rot.transform_vector(x), y, eps)
        return 7;
    if !approx_f32(m3_rot.determinant(), 1.0, eps)
        return 8;

    m3_quat := math.Mat3::<f32>.from_quat(qz);
    if !vec3_approx_f32(m3_quat.transform_vector(x), y, eps)
        return 9;

    m3_scale := math.Mat3::<f32>.scaling(math.Vec3::<f32>.new(2.0, 3.0, 4.0));
    scaled3 := m3_scale.transform_vector(math.Vec3::<f32>.one());
    if !vec3_approx_f32(scaled3, math.Vec3::<f32>.new(2.0, 3.0, 4.0), eps)
        return 10;

    m3_cancel := m3_rot * m3_rot.transpose();
    if !vec3_approx_f32(m3_cancel.transform_vector(x), x, eps)
        return 11;

    translation := math.Mat4::<f32>.translation(math.Vec3::<f32>.new(10.0, 20.0, 30.0));
    if !vec3_approx_f32(translation.transform_point(x), math.Vec3::<f32>.new(11.0, 20.0, 30.0), eps)
        return 12;
    if !vec3_approx_f32(translation.transform_vector(x), x, eps)
        return 13;

    rotation := math.Mat4::<f32>.rotation_z(math.half_pi);
    if !vec3_approx_f32(rotation.transform_vector(x), y, eps)
        return 14;

    composed := translation * rotation;
    if !vec3_approx_f32(composed.transform_point(x), math.Vec3::<f32>.new(10.0, 21.0, 30.0), eps)
        return 15;

    from_q := math.Mat4::<f32>.from_quat(qz);
    if !vec3_approx_f32(from_q.transform_vector(x), y, eps)
        return 16;

    trs := math.Mat4::<f32>.from_trs(
        math.Vec3::<f32>.new(10.0, 20.0, 30.0),
        qz,
        math.Vec3::<f32>.new(2.0, 3.0, 4.0)
    );
    if !vec3_approx_f32(trs.transform_point(x), math.Vec3::<f32>.new(10.0, 22.0, 30.0), eps)
        return 17;

    m64 := math.Mat4::<f64>.translation(math.Vec3::<f64>.new(1.0, 2.0, 3.0));
    p64 := m64.transform_point(math.Vec3::<f64>.zero());
    eps64: f64 = 0.000000000001;
    if !approx_f64(p64.x, 1.0, eps64) || !approx_f64(p64.y, 2.0, eps64) || !approx_f64(p64.z, 3.0, eps64)
        return 18;

    if !vec3_approx_f32(math.Mat4::<f32>.identity().transform_point(zero), zero, eps)
        return 19;

    return 0;
}

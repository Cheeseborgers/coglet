checked_ops::(a: i32, b: i32, negative: i32, six: i32, seven: i32, eighty_five: i32) -> i32 {
    if a + b != 42
        return 1;
    if negative - b != -42
        return 2;
    if six * seven != 42
        return 3;
    if eighty_five / b != 42
        return 4;
    if eighty_five % b != 1
        return 5;
    if -a != -40
        return 6;
    return 0;
}

checked_unsigned_ops::(a: u32, b: u32, six: u32, seven: u32, eighty_five: u32) -> i32 {
    if a + b != 42
        return 7;
    if a - b != 38
        return 8;
    if six * seven != 42
        return 9;
    if eighty_five / b != 42
        return 18;
    if eighty_five % b != 1
        return 19;
    return 0;
}

checked_short_circuit::(a: i32, b: i32, enabled: bool) -> bool {
    return a + b == 42 && enabled;
}

wrapping_ops::(smax: i8, smin: i8, one: i8, sixty_four: i8, umax: u8, uzero: u8, uone: u8, twenty: u8) -> i32 {
    if wrapping_add(smax, one) != -128
        return 10;
    if wrapping_sub(smin, one) != 127
        return 11;
    if wrapping_mul(sixty_four, cast(i8, 2)) != -128
        return 12;
    if wrapping_neg(smin) != -128
        return 13;
    if wrapping_add(umax, uone) != 0
        return 14;
    if wrapping_sub(uzero, uone) != 255
        return 15;
    if wrapping_mul(twenty, twenty) != 144
        return 16;
    if wrapping_neg(uone) != 255
        return 17;
    return 0;
}

bitwise_ops::(a: u8, b: u8) -> i32 {
    if (a & b) != 0
        return 20;
    if (a | b) != 255
        return 21;
    if (a ^ b) != 255
        return 22;
    if ~a != 85
        return 23;
    return 0;
}

shift_ops::(left: u8, signed_left: i8, signed_count: i32, unsigned_count: u8) -> i32 {
    if (left << unsigned_count) != 84
        return 30;
    if (left >> signed_count) != 21
        return 31;
    if (signed_left >> signed_count) != -2
        return 32;
    if (cast(i8, 64) << unsigned_count) != -128
        return 33;
    return 0;
}

cast_ops::(positive: i64, negative: i64, unsigned_value: u64, signed_byte: i8) -> i32 {
    if cast(u8, positive) != 255
        return 40;
    if cast(i16, negative) != -128
        return 41;
    if cast(i64, unsigned_value) != 255
        return 42;
    if truncate(u8, positive) != 255
        return 43;
    if truncate(i8, unsigned_value) != -1
        return 44;
    if truncate(u16, signed_byte) != 65535
        return 45;
    return 0;
}

main::() -> i32 {
    result := checked_ops(40, 2, -40, 6, 7, 85);
    if result != 0
        return result;

    result = checked_unsigned_ops(40, 2, 6, 7, 85);
    if result != 0
        return result;

    if !checked_short_circuit(40, 2, true)
        return 25;

    result = wrapping_ops(127, -128, 1, 64, 255, 0, 1, 20);
    if result != 0
        return result;

    result = bitwise_ops(170, 85);
    if result != 0
        return result;

    result = shift_ops(42, -3, 1, 1);
    if result != 0
        return result;

    return cast_ops(255, -128, 255, -1);
}

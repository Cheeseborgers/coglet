Point::struct {
    x: s32;
}

read_readonly_storage::(
    value: readonly s32*,
    values: readonly s32*,
    point: readonly Point*
) -> s32 {
    /*
     * Reading through readonly pointers is valid.
     */
    first: s32 = *value;
    second: s32 = values[0];
    third: s32 = (*point).x;

    /*
     * Taking the address again must preserve readonly access.
     */
    first_address: readonly s32* =
        &*value;

    second_address: readonly s32* =
        &values[0];

    third_address: readonly s32* =
        &(*point).x;

    return first + second + third;
}

write_mutable_storage::(
    value: s32*,
    values: s32*,
    point: Point*
) -> void {
    /*
     * The equivalent operations remain valid through mutable
     * pointers.
     */
    *value = 1;
    values[0] = 2;
    (*point).x = 3;

    *value += 1;
    (*value)++;
}

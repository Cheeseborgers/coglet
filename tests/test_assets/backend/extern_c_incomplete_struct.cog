#repr(c)
ForeignHandle::struct;

#extern(c, name="coglet_backend_get_incomplete_handle")
get_handle::() -> ForeignHandle*;

#extern(c, name="coglet_backend_incomplete_handle_probe")
probe_handle::(handle: readonly ForeignHandle*) -> c_int;

main::() -> c_int {
    return probe_handle(get_handle());
}

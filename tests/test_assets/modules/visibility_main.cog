import visibility;

main::() -> i32 {
    pair: visibility.Pair = visibility.Pair {
        x = visibility.answer,
        y = visibility.compute(1),
    };

    visibility.counter += 1;

    if visibility.left != 6 || visibility.right != 5
        return 2;

    if visibility.Mode.One == visibility.Mode.Zero
        return 1;

    return pair.x + pair.y + visibility.counter - 11;
}

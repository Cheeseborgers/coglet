module std.mem;

// Copyable allocation capability. Allocator values do not own their state; the
// concrete allocator implementation controls that lifetime.
export #repr(c)
Allocator::struct {
    state: opaque*;
    allocate: cfn(opaque*, c_size, c_size) -> opaque*;
    resize: cfn(opaque*, opaque*, c_size, c_size, c_size) -> opaque*;
    free: cfn(opaque*, opaque*, c_size, c_size) -> void;
}

export alloc::<T>(allocator: Allocator, count: usize) -> T* {
    if count == 0
        return null;

    bytes := count * size_of(T);
    raw := allocator.allocate(
        allocator.state,
        cast(c_size, bytes),
        cast(c_size, align_of(T))
    );
    return reinterpret(T*, raw);
}

export resize::<T>(allocator: Allocator, pointer: T*, old_count: usize, new_count: usize) -> T* {
    if new_count == 0 {
        free(allocator, pointer, old_count);
        return null;
    }

    old_bytes := old_count * size_of(T);
    new_bytes := new_count * size_of(T);
    raw := allocator.resize(
        allocator.state,
        reinterpret(opaque*, pointer),
        cast(c_size, old_bytes),
        cast(c_size, new_bytes),
        cast(c_size, align_of(T))
    );
    return reinterpret(T*, raw);
}

export free::<T>(allocator: Allocator, pointer: T*, count: usize) -> void {
    if pointer == null
        return;

    bytes := count * size_of(T);
    allocator.free(
        allocator.state,
        reinterpret(opaque*, pointer),
        cast(c_size, bytes),
        cast(c_size, align_of(T))
    );
}


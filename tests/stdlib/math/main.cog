import std.math;

approx_f32::(a: f32, b: f32, epsilon: f32) -> bool {
    diff := a - b;
    if diff < 0.0
        diff = -diff;
    return diff <= epsilon;
}

approx_f64::(a: f64, b: f64, epsilon: f64) -> bool {
    diff := a - b;
    if diff < 0.0
        diff = -diff;
    return diff <= epsilon;
}

main::() -> s32 {
    if std.math.abs_s32(-42) != 42
        return 1;
    if std.math.abs_s32(17) != 17
        return 2;

    if std.math.min(10, 20) != 10
        return 3;
    if std.math.max(10, 20) != 20
        return 4;
    if std.math.min::<u64>(30, 20) != 20
        return 5;
    if std.math.max::<s64>(-30, -20) != -20
        return 6;

    if std.math.clamp(5, 0, 10) != 5
        return 7;
    if std.math.clamp(-5, 0, 10) != 0
        return 8;
    if std.math.clamp(15, 0, 10) != 10
        return 9;
    if std.math.clamp01(-0.5) != 0.0
        return 10;
    if std.math.clamp01(1.5) != 1.0
        return 11;

    if std.math.lerp(10.0, 20.0, 0.25) != 12.5
        return 12;
    if std.math.lerp(10.0, 20.0, 1.5) != 25.0
        return 13;
    if std.math.inverse_lerp(10.0, 20.0, 12.5) != 0.25
        return 14;
    if std.math.remap(0.0, 10.0, 0.0, 100.0, 2.5) != 25.0
        return 15;
    if std.math.smoothstep(0.0, 1.0, 0.0) != 0.0
        return 16;
    if std.math.smoothstep(0.0, 1.0, 0.5) != 0.5
        return 17;
    if std.math.smoothstep(0.0, 1.0, 1.0) != 1.0
        return 18;

    if std.math.to_radians(180.0) != std.math.pi
        return 19;
    if std.math.to_degrees(std.math.pi) != 180.0
        return 20;

    if std.math.gcd_u64(84, 30) != 6
        return 21;
    if std.math.gcd_u64(0, 42) != 42
        return 22;
    if std.math.gcd_u64(42, 0) != 42
        return 23;

    ps32: f32 = std.math.pi;
    ps64: f64 = std.math.pi;
    tau32: f32 = std.math.tau;
    tau64: f64 = std.math.tau;
    e64: f64 = std.math.e;
    half_ps64: f64 = std.math.half_pi;
    quarter_ps64: f64 = std.math.quarter_pi;
    inv_ps64: f64 = std.math.inv_pi;
    inv_tau64: f64 = std.math.inv_tau;
    sqrt_2_64: f64 = std.math.sqrt_2;
    deg_to_rad64: f64 = std.math.deg_to_rad;
    rad_to_deg64: f64 = std.math.rad_to_deg;

    a32: f32 = 10.0;
    b32: f32 = 20.0;
    t32: f32 = 0.25;
    degrees32: f32 = 180.0;
    zero32: f32 = 0.0;
    one32: f32 = 1.0;
    half32: f32 = 0.5;

    if std.math.lerp(a32, b32, t32) != 12.5
        return 36;
    if std.math.smoothstep(zero32, one32, half32) != half32
        return 37;
    if std.math.to_radians(degrees32) != ps32
        return 38;

    eps32: f32 = 0.0001;
    eps64: f64 = 0.000000000001;

    if !approx_f32(std.math.sqrt_f32(9.0), 3.0, eps32)
        return 39;
    if !approx_f64(std.math.sqrt_f64(9.0), 3.0, eps64)
        return 40;

    if !approx_f32(std.math.sin_f32(std.math.half_pi), 1.0, eps32)
        return 41;
    if !approx_f64(std.math.sin_f64(std.math.half_pi), 1.0, eps64)
        return 42;
    if !approx_f32(std.math.cos_f32(std.math.pi), -1.0, eps32)
        return 43;
    if !approx_f64(std.math.cos_f64(std.math.pi), -1.0, eps64)
        return 44;
    if !approx_f32(std.math.tan_f32(std.math.quarter_pi), 1.0, eps32)
        return 45;
    if !approx_f64(std.math.tan_f64(std.math.quarter_pi), 1.0, eps64)
        return 46;

    if !approx_f32(std.math.asin_f32(1.0), std.math.half_pi, eps32)
        return 47;
    if !approx_f64(std.math.asin_f64(1.0), std.math.half_pi, eps64)
        return 48;
    if !approx_f32(std.math.acos_f32(0.0), std.math.half_pi, eps32)
        return 49;
    if !approx_f64(std.math.acos_f64(0.0), std.math.half_pi, eps64)
        return 50;
    if !approx_f32(std.math.atan_f32(1.0), std.math.quarter_pi, eps32)
        return 51;
    if !approx_f64(std.math.atan_f64(1.0), std.math.quarter_pi, eps64)
        return 52;
    if !approx_f32(std.math.atan2_f32(1.0, 0.0), std.math.half_pi, eps32)
        return 53;
    if !approx_f64(std.math.atan2_f64(1.0, 0.0), std.math.half_pi, eps64)
        return 54;

    if std.math.floor_f32(1.75) != 1.0
        return 55;
    if std.math.floor_f64(-1.25) != -2.0
        return 56;
    if std.math.ceil_f32(1.25) != 2.0
        return 57;
    if std.math.ceil_f64(-1.75) != -1.0
        return 58;
    if std.math.round_f32(1.5) != 2.0
        return 59;
    if std.math.round_f64(-1.5) != -2.0
        return 60;
    if std.math.trunc_f32(1.75) != 1.0
        return 61;
    if std.math.trunc_f64(-1.75) != -1.0
        return 62;

    if !approx_f32(std.math.fmod_f32(5.5, 2.0), 1.5, eps32)
        return 63;
    if !approx_f64(std.math.fmod_f64(-5.5, 2.0), -1.5, eps64)
        return 64;

    if ps32 < 3.1415 || ps32 > 3.1416
        return 24;
    if ps64 != 0x1.921fb54442d18p+1
        return 25;
    if tau32 != ps32 * 2.0
        return 26;
    if tau64 != 0x1.921fb54442d18p+2
        return 27;
    if e64 != 0x1.5bf0a8b145769p+1
        return 28;
    if half_ps64 != 0x1.921fb54442d18p+0
        return 29;
    if quarter_ps64 != 0x1.921fb54442d18p-1
        return 30;
    if inv_ps64 != 0x1.45f306dc9c883p-2
        return 31;
    if inv_tau64 != 0x1.45f306dc9c883p-3
        return 32;
    if sqrt_2_64 != 0x1.6a09e667f3bcdp+0
        return 33;
    if deg_to_rad64 != 0x1.1df46a2529d39p-6
        return 34;
    if rad_to_deg64 != 0x1.ca5dc1a63c1f8p+5
        return 35;

    return 0;
}

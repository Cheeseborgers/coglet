U8Zero :: enum(u8) {
    Expected = 0,
}

U8Maximum :: enum(u8) {
    Expected = 255,
}

U8OneFortyFour :: enum(u8) {
    Expected = 144,
}

S8Minimum :: enum(s8) {
    Expected = -128,
}

S8Maximum :: enum(s8) {
    Expected = 127,
}

U8_ADD_WRAP ::
    cast(
        U8Zero,
        wrapping_add(
            cast(u8, 255),
            cast(u8, 1)
        )
    );

U8_SUB_WRAP ::
    cast(
        U8Maximum,
        wrapping_sub(
            cast(u8, 0),
            cast(u8, 1)
        )
    );

U8_MUL_WRAP ::
    cast(
        U8OneFortyFour,
        wrapping_mul(
            cast(u8, 20),
            cast(u8, 20)
        )
    );

U8_NEG_WRAP ::
    cast(
        U8Maximum,
        wrapping_neg(
            cast(u8, 1)
        )
    );

S8_ADD_WRAP ::
    cast(
        S8Minimum,
        wrapping_add(
            cast(s8, 127),
            cast(s8, 1)
        )
    );

S8_SUB_WRAP ::
    cast(
        S8Maximum,
        wrapping_sub(
            cast(s8, -128),
            cast(s8, 1)
        )
    );

S8_MUL_WRAP ::
    cast(
        S8Minimum,
        wrapping_mul(
            cast(s8, 64),
            cast(s8, 2)
        )
    );

S8_NEG_MIN ::
    cast(
        S8Minimum,
        wrapping_neg(
            cast(s8, -128)
        )
    );

Point :: struct {
    x: s32;
}

parameter_read::(value: s32) -> s32 {
    return value;
}

initialized_declaration::() -> s32 {
    value: s32 = 10;
    return value;
}

plain_assignment_initializes::() -> s32 {
    value: s32;
    value = 20;
    return value;
}

whole_struct_assignment_initializes::() -> s32 {
    point: Point;

    point = Point {
        x = 30,
    };

    return point.x;
}

whole_array_assignment_initializes::() -> s32 {
    values: s32[2];
    values = [40, 50];

    return values[0];
}

unused_uninitialized_local_is_valid::() -> void {
    value: s32;
}

shadowed_variables_have_distinct_state::() -> s32 {
    value: s32;
    value = 1;

    {
        value: s32;
        value = 2;
        value;
    }

    return value;
}

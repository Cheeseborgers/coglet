Kind:: enum(u8) {
    One,
}

Pair:: struct {
    value: s32;
}

shift_operand_types::() -> void {
    integer: s32 = 1;
    floating: f32 = 1.0;
    boolean: bool = true;
    enumeration: Kind = Kind.One;
    pointer: s32* = &integer;
    array: s32[2] = [1, 2];
    pair: Pair = Pair { value = 1, };

    floating << 1;
    integer << floating;
    boolean >> 1;
    integer >> boolean;
    enumeration << 1;
    integer << enumeration;
    pointer >> 1;
    null << 1;
    array >> 1;
    pair << 1;
}

import std.io;

main::() -> s32 {
    std.io.println("=== inline asm smoke test ===");

    value: s64 = 41;
    result: s64 = 0;

    std.io.print("input: ");
    std.io.print_s64(value);
    std.io.newline();

    asm volatile ("movq %1, %0" : "=r"(result) : "r"(value));

    std.io.print("asm output: ");
    std.io.print_s64(result);
    std.io.newline();

    if (result != value) {
        std.io.println("FAIL");
        return 1;
    }

    asm volatile ("incq %0" : "+r"(value));

    std.io.print("asm output: ");
        std.io.print_s64(value);
        std.io.newline();

    if (result != 42) {
        std.io.println("FAIL");
        return 1;
    }

    std.io.println("PASS");
    return 0;
}

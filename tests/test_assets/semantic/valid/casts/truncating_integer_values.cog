U8Zero :: enum(u8) {
    Expected = 0,
}

U8Maximum :: enum(u8) {
    Expected = 255,
}

S8NegativeOne :: enum(s8) {
    Expected = -1,
}

S8Minimum :: enum(s8) {
    Expected = -128,
}

U16Maximum :: enum(u16) {
    Expected = 65535,
}

TRUNCATE_256_TO_U8 ::
    cast(
        U8Zero,
        truncate(u8, 256)
    );

TRUNCATE_NEGATIVE_ONE_TO_U8 ::
    cast(
        U8Maximum,
        truncate(u8, -1)
    );

TRUNCATE_255_TO_S8 ::
    cast(
        S8NegativeOne,
        truncate(s8, 255)
    );

TRUNCATE_128_TO_S8 ::
    cast(
        S8Minimum,
        truncate(s8, 128)
    );

TRUNCATE_NEGATIVE_S8_TO_U16 ::
    cast(
        U16Maximum,
        truncate(
            u16,
            cast(s8, -1)
        )
    );

control_flow_syntax::(limit: u32, flag: bool) -> u32 {
    value: u32 = 0;

    if flag
        value += 1;
    else if limit == 0
        value += 2;
    else
        value += 3;

    if flag
        if limit == 0
            value += 4;
        else
            value += 5;

    while value < 2
        value++;

    for value < 3 : value++
        continue;

    for (value < 4 : value++)
        continue;

    for (i: u32 = 0; i < limit; i++)
        value += i;

    for (; value < 10; value++)
        continue;

    for (value = 0; value < 1;)
        value++;

    for (value = 0; ; value++) {
        if value == 2
            break;
    }

    for (;;)
        break;

    return value;
}

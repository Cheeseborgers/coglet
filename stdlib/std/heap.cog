module std.heap;

import std.mem as mem;

#extern(c, name="coglet_rt_mem_heap_alloc")
heap_alloc::(state: opaque*, size: c_size, alignment: c_size) -> opaque*;

#extern(c, name="coglet_rt_mem_heap_resize")
heap_resize::(state: opaque*, pointer: opaque*, old_size: c_size, new_size: c_size, alignment: c_size) -> opaque*;

#extern(c, name="coglet_rt_mem_heap_free")
heap_free::(state: opaque*, pointer: opaque*, size: c_size, alignment: c_size) -> void;

#extern(c, name="coglet_rt_mem_arena_create")
arena_create::(parent: mem.Allocator, block_size: c_size) -> opaque*;

#extern(c, name="coglet_rt_mem_arena_reset")
arena_reset::(state: opaque*) -> void;

#extern(c, name="coglet_rt_mem_arena_destroy")
arena_destroy::(state: opaque*) -> void;

#extern(c, name="coglet_rt_mem_arena_alloc")
arena_alloc::(state: opaque*, size: c_size, alignment: c_size) -> opaque*;

#extern(c, name="coglet_rt_mem_arena_resize")
arena_resize::(state: opaque*, pointer: opaque*, old_size: c_size, new_size: c_size, alignment: c_size) -> opaque*;

#extern(c, name="coglet_rt_mem_arena_free")
arena_free::(state: opaque*, pointer: opaque*, size: c_size, alignment: c_size) -> void;

export heap::() -> mem.Allocator {
    return mem.Allocator {
        state = null,
        allocate = heap_alloc,
        resize = heap_resize,
        free = heap_free
    };
}

// Growable region allocator. Allocations are individually addressable but
// individual free operations are no-ops; reset() releases all allocations for
// reuse and deinit() returns every backing block to the parent allocator.
export Arena::resource {
    state: opaque*;

    new::(parent: mem.Allocator) -> Self {
        return Self.with_block_size(parent, 65536);
    }

    with_block_size::(parent: mem.Allocator, block_size: usize) -> Self {
        return Self {
            state = arena_create(parent, cast(c_size, block_size))
        };
    }

    allocator::(self: readonly Self*) -> mem.Allocator {
        return mem.Allocator {
            state = (*self).state,
            allocate = arena_alloc,
            resize = arena_resize,
            free = arena_free
        };
    }

    reset::(self: Self*) -> void {
        arena_reset((*self).state);
    }

    deinit::(self: Self*) -> void {
        arena_destroy((*self).state);
        (*self).state = null;
    }
}

#extern(c, name="coglet_rt_mem_arena_mark")
arena_mark::(state: opaque*, out_block: opaque**, out_used: c_size*) -> void;

#extern(c, name="coglet_rt_mem_arena_rewind")
arena_rewind::(state: opaque*, mark_block: opaque*, mark_used: c_size) -> void;

#extern(c, name="coglet_rt_mem_fixed_arena_create")
fixed_arena_create::(buffer: opaque*, size: c_size) -> opaque*;

#extern(c, name="coglet_rt_mem_fixed_arena_reset")
fixed_arena_reset::(state: opaque*) -> void;

#extern(c, name="coglet_rt_mem_fixed_arena_alloc")
fixed_arena_alloc::(state: opaque*, size: c_size, alignment: c_size) -> opaque*;

#extern(c, name="coglet_rt_mem_fixed_arena_resize")
fixed_arena_resize::(state: opaque*, pointer: opaque*, old_size: c_size, new_size: c_size, alignment: c_size) -> opaque*;

#extern(c, name="coglet_rt_mem_fixed_arena_free")
fixed_arena_free::(state: opaque*, pointer: opaque*, size: c_size, alignment: c_size) -> void;

#extern(c, name="coglet_rt_mem_fixed_arena_used")
fixed_arena_used::(state: opaque*) -> c_size;

#extern(c, name="coglet_rt_mem_fixed_arena_remaining")
fixed_arena_remaining::(state: opaque*) -> c_size;

// Non-owning checkpoint over a growable Arena. deinit() rewinds the arena to
// the checkpoint captured by begin(). Scratch scopes may be nested when they
// are ended in LIFO order.
export Scratch::resource {
    arena_state: opaque*;
    mark_block: opaque*;
    mark_used: c_size;

    begin::(arena: Arena*) -> Self {
        block: opaque* = null;
        used: c_size = 0;
        arena_mark((*arena).state, &block, &used);
        return Self {
            arena_state = (*arena).state,
            mark_block = block,
            mark_used = used
        };
    }

    allocator::(self: readonly Self*) -> mem.Allocator {
        return mem.Allocator {
            state = (*self).arena_state,
            allocate = arena_alloc,
            resize = arena_resize,
            free = arena_free
        };
    }

    deinit::(self: Self*) -> void {
        if (*self).arena_state == null
            return;
        arena_rewind((*self).arena_state, (*self).mark_block, (*self).mark_used);
        (*self).arena_state = null;
        (*self).mark_block = null;
        (*self).mark_used = 0;
    }
}

// Caller-owned fixed-buffer arena. The runtime bookkeeping lives inside the
// supplied mutable byte buffer; this type performs no heap allocation.
export FixedArena::resource {
    state: opaque*;

    from_buffer::(buffer: u8[]) -> Self {
        return Self {
            state = fixed_arena_create(
                reinterpret(opaque*, buffer.data),
                cast(c_size, buffer.len)
            )
        };
    }

    allocator::(self: readonly Self*) -> mem.Allocator {
        return mem.Allocator {
            state = (*self).state,
            allocate = fixed_arena_alloc,
            resize = fixed_arena_resize,
            free = fixed_arena_free
        };
    }

    reset::(self: Self*) -> void {
        fixed_arena_reset((*self).state);
    }

    used::(self: readonly Self*) -> usize {
        return cast(usize, fixed_arena_used((*self).state));
    }

    remaining::(self: readonly Self*) -> usize {
        return cast(usize, fixed_arena_remaining((*self).state));
    }

    deinit::(self: Self*) -> void {
        // The caller owns the backing buffer. There is nothing to free.
        (*self).state = null;
    }
}

#extern(c, name="coglet_rt_mem_debug_create")
debug_create::(parent: mem.Allocator) -> opaque*;

#extern(c, name="coglet_rt_mem_debug_destroy")
debug_destroy::(state: opaque*) -> void;

#extern(c, name="coglet_rt_mem_debug_alloc")
debug_alloc::(state: opaque*, size: c_size, alignment: c_size) -> opaque*;

#extern(c, name="coglet_rt_mem_debug_resize")
debug_resize::(state: opaque*, pointer: opaque*, old_size: c_size, new_size: c_size, alignment: c_size) -> opaque*;

#extern(c, name="coglet_rt_mem_debug_free")
debug_free::(state: opaque*, pointer: opaque*, size: c_size, alignment: c_size) -> void;

#extern(c, name="coglet_rt_mem_debug_check")
debug_check::(state: opaque*) -> bool;

#extern(c, name="coglet_rt_mem_debug_live_allocations")
debug_live_allocations::(state: opaque*) -> u64;

#extern(c, name="coglet_rt_mem_debug_live_bytes")
debug_live_bytes::(state: opaque*) -> u64;

#extern(c, name="coglet_rt_mem_debug_total_allocations")
debug_total_allocations::(state: opaque*) -> u64;

#extern(c, name="coglet_rt_mem_debug_total_bytes")
debug_total_bytes::(state: opaque*) -> u64;

#extern(c, name="coglet_rt_mem_debug_error_count")
debug_error_count::(state: opaque*) -> u64;

#extern(c, name="coglet_rt_mem_debug_report_leaks")
debug_report_leaks::(state: opaque*) -> u64;

// Debug wrapper over any existing allocator. It tracks live allocations,
// validates fixed front/back guards, poisons allocated/freed storage, and can
// report outstanding blocks. The returned mem.Allocator is a non-owning handle and
// becomes invalid after DebugAllocator.deinit().
export DebugAllocator::resource {
    state: opaque*;

    new::(parent: mem.Allocator) -> Self {
        return Self {
            state = debug_create(parent)
        };
    }

    allocator::(self: readonly Self*) -> mem.Allocator {
        return mem.Allocator {
            state = (*self).state,
            allocate = debug_alloc,
            resize = debug_resize,
            free = debug_free
        };
    }

    check::(self: readonly Self*) -> bool {
        return debug_check((*self).state);
    }

    live_allocations::(self: readonly Self*) -> u64 {
        return debug_live_allocations((*self).state);
    }

    live_bytes::(self: readonly Self*) -> u64 {
        return debug_live_bytes((*self).state);
    }

    total_allocations::(self: readonly Self*) -> u64 {
        return debug_total_allocations((*self).state);
    }

    total_bytes::(self: readonly Self*) -> u64 {
        return debug_total_bytes((*self).state);
    }

    error_count::(self: readonly Self*) -> u64 {
        return debug_error_count((*self).state);
    }

    report_leaks::(self: readonly Self*) -> u64 {
        return debug_report_leaks((*self).state);
    }

    deinit::(self: Self*) -> void {
        if (*self).state == null
            return;
        debug_destroy((*self).state);
        (*self).state = null;
    }
}




pool_invalid_index :: truncate(usize, 0xffffffffffffffff);
pool_live_index :: truncate(usize, 0xfffffffffffffffe);

// Stable slot identifier. Generation changes whenever a slot is released so
// stale handles do not silently refer to a later occupant of the same index.
export PoolHandle::struct {
    index: usize;
    generation: u64;

    invalid::() -> Self {
        return Self {
            index = pool_invalid_index,
            generation = 0
        };
    }

    is_invalid::(self: readonly Self*) -> bool {
        return (*self).index == pool_invalid_index;
    }
}

// Fixed-capacity stable-address pool for copyable values. The pool owns its
// backing storage, but never relocates it after construction.
export Pool::<T: copyable> resource {
    data: T*;
    next_free: usize*;
    generations: u64*;
    capacity: usize;
    free_head: usize;
    live_count: usize;
    allocator: mem.Allocator;

    with_capacity::(allocator: mem.Allocator, capacity: usize) -> Self {
        result := Self {
            data = null,
            next_free = null,
            generations = null,
            capacity = capacity,
            free_head = pool_invalid_index,
            live_count = 0,
            allocator = allocator
        };

        if capacity == 0
            return move result;

        result.data = mem.alloc::<T>(allocator, capacity);
        result.next_free = mem.alloc::<usize>(allocator, capacity);
        result.generations = mem.alloc::<u64>(allocator, capacity);
        result.free_head = 0;

        i: usize = 0;
        while i < capacity {
            result.generations[i] = 1;
            if i + 1 < capacity
                result.next_free[i] = i + 1;
            else
                result.next_free[i] = pool_invalid_index;
            i += 1;
        }

        return move result;
    }

    deinit::(self: Self*) -> void {
        mem.free((*self).allocator, (*self).data, (*self).capacity);
        mem.free((*self).allocator, (*self).next_free, (*self).capacity);
        mem.free((*self).allocator, (*self).generations, (*self).capacity);
        (*self).data = null;
        (*self).next_free = null;
        (*self).generations = null;
        (*self).capacity = 0;
        (*self).free_head = pool_invalid_index;
        (*self).live_count = 0;
    }

    is_empty::(self: readonly Self*) -> bool {
        return (*self).live_count == 0;
    }

    is_full::(self: readonly Self*) -> bool {
        return (*self).live_count == (*self).capacity;
    }

    available::(self: readonly Self*) -> usize {
        return (*self).capacity - (*self).live_count;
    }

    contains::(self: readonly Self*, handle: PoolHandle) -> bool {
        if handle.index >= (*self).capacity
            return false;
        if (*self).next_free[handle.index] != pool_live_index
            return false;
        return (*self).generations[handle.index] == handle.generation;
    }

    insert::(self: Self*, value: T) -> PoolHandle {
        if (*self).free_head == pool_invalid_index
            return PoolHandle.invalid();

        index := (*self).free_head;
        (*self).free_head = (*self).next_free[index];
        (*self).next_free[index] = pool_live_index;
        (*self).data[index] = value;
        (*self).live_count += 1;

        return PoolHandle {
            index = index,
            generation = (*self).generations[index]
        };
    }

    get::(self: Self*, handle: PoolHandle) -> T* {
        if !(*self).contains(handle)
            return null;
        return &(*self).data[handle.index];
    }

    get_readonly::(self: readonly Self*, handle: PoolHandle) -> readonly T* {
        if !(*self).contains(handle)
            return null;
        return &(*self).data[handle.index];
    }

    remove::(self: Self*, handle: PoolHandle) -> bool {
        if !(*self).contains(handle)
            return false;

        index := handle.index;
        generation := (*self).generations[index];
        if generation == 0xffffffffffffffff {
            (*self).generations[index] = 1;
        } else {
            (*self).generations[index] = generation + 1;
        }

        (*self).next_free[index] = (*self).free_head;
        (*self).free_head = index;
        (*self).live_count -= 1;
        return true;
    }

    clear::(self: Self*) -> void {
        i: usize = 0;
        while i < (*self).capacity {
            generation := (*self).generations[i];
            if generation == 0xffffffffffffffff {
                (*self).generations[i] = 1;
            } else {
                (*self).generations[i] = generation + 1;
            }

            if i + 1 < (*self).capacity {
                (*self).next_free[i] = i + 1;
            } else {
                (*self).next_free[i] = pool_invalid_index;
            }
            i += 1;
        }

        if (*self).capacity == 0 {
            (*self).free_head = pool_invalid_index;
        } else {
            (*self).free_head = 0;
        }
        (*self).live_count = 0;
    }
}

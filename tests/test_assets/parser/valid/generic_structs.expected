    struct_field_decl x: T
    struct_field_decl y: T
  struct Box<T>
    struct_field_decl value: T
  func main -> s32
    body:
      block
        var_decl pair: Pair::<s32, f32>
          init:
            struct_init Pair::<s32, f32>
              field_init first
                7
              field_init second
                2.5
        var_decl nested: Box::<Pair::<s32, f32>>

module std.math;

// Adaptable floating-point constants. Context chooses f32 or f64.
export pi         :: 0x1.921fb54442d18p+1;
export tau        :: 0x1.921fb54442d18p+2;
export e          :: 0x1.5bf0a8b145769p+1;
export half_pi    :: 0x1.921fb54442d18p+0;
export quarter_pi :: 0x1.921fb54442d18p-1;
export inv_pi     :: 0x1.45f306dc9c883p-2;
export inv_tau    :: 0x1.45f306dc9c883p-3;
export sqrt_2     :: 0x1.6a09e667f3bcdp+0;
export deg_to_rad :: 0x1.1df46a2529d39p-6;
export rad_to_deg :: 0x1.ca5dc1a63c1f8p+5;

export abs_s32::(value: s32) -> s32 {
    if value < 0
        return -value;

    return value;
}

export min::<T: ordered>(a: T, b: T) -> T {
    if a < b
        return a;

    return b;
}

export max::<T: ordered>(a: T, b: T) -> T {
    if a > b
        return a;

    return b;
}

// Requires low <= high.
export clamp::<T: ordered>(value: T, low: T, high: T) -> T {
    if value < low
        return low;

    if value > high
        return high;

    return value;
}

export clamp01::<T: floating>(value: T) -> T {
    if value < 0.0
        return 0.0;

    if value > 1.0
        return 1.0;

    return value;
}

// Linear interpolation. t is not clamped, so values outside [0, 1] extrapolate.
export lerp::<T: floating>(a: T, b: T, t: T) -> T {
    return a + (b - a) * t;
}

// Requires a != b.
export inverse_lerp::<T: floating>(a: T, b: T, value: T) -> T {
    return (value - a) / (b - a);
}

// Requires in_min != in_max. The result is not clamped to the output range.
export remap::<T: floating>(in_min: T, in_max: T, out_min: T, out_max: T, value: T) -> T {
    t := inverse_lerp(in_min, in_max, value);
    return lerp(out_min, out_max, t);
}

// Cubic Hermite interpolation from 0 to 1. Requires edge0 < edge1.
export smoothstep::<T: floating>(edge0: T, edge1: T, value: T) -> T {
    t := clamp01((value - edge0) / (edge1 - edge0));
    return t * t * (3.0 - 2.0 * t);
}

export to_radians::<T: floating>(degrees: T) -> T {
    return degrees * deg_to_rad;
}

export to_degrees::<T: floating>(radians: T) -> T {
    return radians * rad_to_deg;
}

// Runtime-backed floating-point math. Coglet does not yet have overloads or
// compile-time type dispatch, so the initial public API names the precision
// explicitly. Both precisions use the same backend-neutral runtime ABI.

export #extern(c, name="coglet_rt_math_sqrt_f32")
sqrt_f32::(value: f32) -> f32;
export #extern(c, name="coglet_rt_math_sqrt_f64")
sqrt_f64::(value: f64) -> f64;

export #extern(c, name="coglet_rt_math_sin_f32")
sin_f32::(value: f32) -> f32;
export #extern(c, name="coglet_rt_math_sin_f64")
sin_f64::(value: f64) -> f64;

export #extern(c, name="coglet_rt_math_cos_f32")
cos_f32::(value: f32) -> f32;
export #extern(c, name="coglet_rt_math_cos_f64")
cos_f64::(value: f64) -> f64;

export #extern(c, name="coglet_rt_math_tan_f32")
tan_f32::(value: f32) -> f32;
export #extern(c, name="coglet_rt_math_tan_f64")
tan_f64::(value: f64) -> f64;

export #extern(c, name="coglet_rt_math_asin_f32")
asin_f32::(value: f32) -> f32;
export #extern(c, name="coglet_rt_math_asin_f64")
asin_f64::(value: f64) -> f64;

export #extern(c, name="coglet_rt_math_acos_f32")
acos_f32::(value: f32) -> f32;
export #extern(c, name="coglet_rt_math_acos_f64")
acos_f64::(value: f64) -> f64;

export #extern(c, name="coglet_rt_math_atan_f32")
atan_f32::(value: f32) -> f32;
export #extern(c, name="coglet_rt_math_atan_f64")
atan_f64::(value: f64) -> f64;

export #extern(c, name="coglet_rt_math_atan2_f32")
atan2_f32::(y: f32, x: f32) -> f32;
export #extern(c, name="coglet_rt_math_atan2_f64")
atan2_f64::(y: f64, x: f64) -> f64;

export #extern(c, name="coglet_rt_math_floor_f32")
floor_f32::(value: f32) -> f32;
export #extern(c, name="coglet_rt_math_floor_f64")
floor_f64::(value: f64) -> f64;

export #extern(c, name="coglet_rt_math_ceil_f32")
ceil_f32::(value: f32) -> f32;
export #extern(c, name="coglet_rt_math_ceil_f64")
ceil_f64::(value: f64) -> f64;

export #extern(c, name="coglet_rt_math_round_f32")
round_f32::(value: f32) -> f32;
export #extern(c, name="coglet_rt_math_round_f64")
round_f64::(value: f64) -> f64;

export #extern(c, name="coglet_rt_math_trunc_f32")
trunc_f32::(value: f32) -> f32;
export #extern(c, name="coglet_rt_math_trunc_f64")
trunc_f64::(value: f64) -> f64;

export #extern(c, name="coglet_rt_math_fmod_f32")
fmod_f32::(x: f32, y: f32) -> f32;
export #extern(c, name="coglet_rt_math_fmod_f64")
fmod_f64::(x: f64, y: f64) -> f64;

export gcd_u64::(a: u64, b: u64) -> u64 {
    left := a;
    right := b;

    while right != 0 {
        remainder := left % right;
        left = right;
        right = remainder;
    }

    return left;
}

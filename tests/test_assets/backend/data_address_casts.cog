#repr(c)
ProbePair::struct {
    left: c_int;
    weight: c_double;
}

#extern(c, name="coglet_backend_make_pair")
make_pair::(left: c_int, weight: c_double) -> ProbePair;

#repr(c)
ArrayPoint::struct {
    x: c_int;
    y: c_double;
}

#repr(c)
ArrayPacket::struct {
    name: c_char[4];
    points: ArrayPoint[2];
    values: c_int[3];
}

#extern(c, name="coglet_backend_make_array_packet")
make_array_packet::() -> ArrayPacket;

#repr(c)
Mode::enum(c_int) {
    Idle = -1,
    Running = 3,
}

field_and_array_addressing::(pair: ProbePair, packet: ArrayPacket) -> bool {
    pair.left += 5;
    if pair.left != 22 || pair.weight != 2.5 {
        return false;
    }

    packet.values[1] = 29;
    packet.points[1].x = 31;
    if packet.values[1] != 29 || packet.points[1].x != 31 {
        return false;
    }

    return true;
}

pointer_addressing::(seed: s32) -> bool {
    value: s32 = seed;
    pointer: s32* = &value;
    pointer[0] += 2;
    if value != 12 {
        return false;
    }

    *cast(volatile s32*, pointer) = 19;
    loaded := *cast(readonly volatile s32*, pointer);
    if loaded != 19 {
        return false;
    }

    raw: opaque* = reinterpret(opaque*, pointer);
    recovered: s32* = reinterpret(s32*, raw);
    recovered[0] = 23;
    return value == 23;
}

enum_cast_checks::(mode: Mode) -> bool {
    return cast(s32, mode) == 3;
}

cast_checks::(
    positive: s64,
    unsigned_value: u64,
    low: f64,
    high: f64,
    negative_fraction: f64
) -> bool {
    if cast(s16, positive) != 258 {
        return false;
    }
    if cast(u16, positive) != 258 {
        return false;
    }
    if cast(s64, unsigned_value) != 255 {
        return false;
    }
    if cast(u8, unsigned_value) != 255 {
        return false;
    }
    if cast(s8, low) != -128 {
        return false;
    }
    if cast(s8, high) != 127 {
        return false;
    }
    if cast(u8, negative_fraction) != 0 {
        return false;
    }

    narrowed := cast(f32, high);
    widened := cast(f64, narrowed);
    if widened != high {
        return false;
    }
    if cast(f32, positive) != 258.0 {
        return false;
    }

    if truncate(u8, positive) != 2 {
        return false;
    }
    if truncate(s8, unsigned_value) != -1 {
        return false;
    }

    return true;
}

main::() -> s32 {
    if !field_and_array_addressing(make_pair(17, 2.5), make_array_packet()) {
        return 1;
    }
    if !pointer_addressing(10) {
        return 2;
    }
    if !enum_cast_checks(Mode.Running) {
        return 3;
    }
    if !cast_checks(258, 255, -128.75, 127.75, -0.75) {
        return 4;
    }
    return 0;
}

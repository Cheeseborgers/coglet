1 IDENT one
1 COLON_EQUAL :=
1 NUMBER_FLOAT 0x1p0
1 SEMICOLON ;
2 IDENT three
2 COLON_EQUAL :=
2 NUMBER_FLOAT 0x1.8p1
2 SEMICOLON ;
3 IDENT pi
3 COLON_EQUAL :=
3 NUMBER_FLOAT 0x1.921fb54442d18p+1
3 SEMICOLON ;
4 IDENT small
4 COLON_EQUAL :=
4 NUMBER_FLOAT 0x.8p-2
4 SEMICOLON ;
5 IDENT upper
5 COLON_EQUAL :=
5 NUMBER_FLOAT 0X1.AP+4
5 SEMICOLON ;
6 IDENT hex_integer
6 COLON_EQUAL :=
6 NUMBER_INT 0x1e3
6 SEMICOLON ;
7 EOF

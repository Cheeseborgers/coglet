import std.io;

Pair::<T, U> struct {
    first: T;
    second: U;
}

Vec2::<T: numeric> struct {
    x: T;
    y: T;
}

Node::<T> struct {
    value: T;
    next: Node::<T>*;
}

first::<T, U>(pair: Pair::<T, U>) -> T {
    return pair.first;
}

main::() -> s32 {
    pair: Pair::<s32, f32> = Pair::<s32, f32> {
        first = 42,
        second = 2.5
    };

    point: Vec2::<f32> = Vec2::<f32> { x = 3.0, y = 4.0 };
    node: Node::<s32> = Node::<s32> { value = 7, next = null };

    std.io.print("pair.first = ");
    std.io.print_s32(first(pair));
    std.io.newline();

    std.io.print("point = (");
    std.io.print_f32(point.x);
    std.io.print(", ");
    std.io.print_f32(point.y);
    std.io.println(")");

    if node.next != null
        return 1;
    return 0;
}

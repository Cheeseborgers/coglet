module std.math;

export pi :: 0x1.921fb54442d18p+1;
export tau :: 0x1.921fb54442d18p+2;

export abs_i32::(value: i32) -> i32 {
    if value < 0
        return -value;

    return value;
}

export min::<T: ordered>(a: T, b: T) -> T {
    if a < b
        return a;

    return b;
}

export max::<T: ordered>(a: T, b: T) -> T {
    if a > b
        return a;

    return b;
}

export gcd_u64::(a: u64, b: u64) -> u64 {
    left := a;
    right := b;

    while right != 0 {
        remainder := left % right;
        left = right;
        right = remainder;
    }

    return left;
}

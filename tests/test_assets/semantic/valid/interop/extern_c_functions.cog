#extern(c)
consume_s32::(value: s32) -> void;

#extern(c)
inspect_bytes::(data: readonly u8*) -> s32;

#extern(c)
allocate::(size: uint) -> opaque*;

#extern(c)
release::(ptr: opaque*) -> void;

#extern(c)
replace_handle::(slot: opaque**) -> s32;

use_extern::(value: s32, handle: opaque*) -> void {
    consume_s32(value);
    release(handle);
}

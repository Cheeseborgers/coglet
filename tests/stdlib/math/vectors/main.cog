import std.geom;

main::() -> s32 {
    a := std.geom.Vec2::<s32>.new(3, 4);
    b := std.geom.Vec2::<s32>.one();
    chained := a.add(b).scale(2);
    if chained.x != 8 || chained.y != 10
        return 1;

    operator_chained := (a + b) * 2;
    if operator_chained.x != 8 || operator_chained.y != 10
        return 16;

    difference := a - b;
    if difference.x != 2 || difference.y != 3
        return 21;

    mutable_a := a;
    mutable_a += b;
    mutable_a *= 2;
    if mutable_a.x != 8 || mutable_a.y != 10
        return 17;

    mutable_a -= b;
    if mutable_a.x != 7 || mutable_a.y != 9
        return 22;

    negative_a := -a;
    if negative_a.x != -3 || negative_a.y != -4
        return 18;

    if a.dot(a) != 25
        return 2;
    if a.length_squared() != 25
        return 3;
    if a.distance_squared(std.geom.Vec2::<s32>.zero()) != 25
        return 4;

    component := a.mul(std.geom.Vec2::<s32>.new(2, 3));
    if component.x != 6 || component.y != 12
        return 5;

    low := std.geom.Vec2::<s32>.new(0, 5);
    high := std.geom.Vec2::<s32>.new(2, 8);
    bounded := a.clamp(low, high);
    if bounded.x != 2 || bounded.y != 5
        return 6;

    lower := a.min(std.geom.Vec2::<s32>.new(10, 2));
    if lower.x != 3 || lower.y != 2
        return 7;

    upper := a.max(std.geom.Vec2::<s32>.new(10, 2));
    if upper.x != 10 || upper.y != 4
        return 8;

    x_axis := std.geom.Vec3::<s32>.new(1, 0, 0);
    y_axis := std.geom.Vec3::<s32>.new(0, 1, 0);
    z_axis := x_axis.cross(y_axis);
    if z_axis.x != 0 || z_axis.y != 0 || z_axis.z != 1
        return 9;

    f := std.geom.Vec3::<f32>.new(1.0, 2.0, 2.0);
    if f.length_squared() != 9.0
        return 10;
    if f.length() != 3.0
        return 13;

    origin_f := std.geom.Vec3::<f32>.zero();
    if f.distance(origin_f) != 3.0
        return 14;

    unit := f.normalized();
    if unit.x < 0.3332 || unit.x > 0.3334 ||
       unit.y < 0.6665 || unit.y > 0.6668 ||
       unit.z < 0.6665 || unit.z > 0.6668
        return 15;

    half_f := f / 2.0;
    if half_f.x != 0.5 || half_f.y != 1.0 || half_f.z != 1.0
        return 19;

    position := std.geom.Vec3::<f32> { x = 10.0, y = 5.0, z = 2.0 };
    velocity := std.geom.Vec3::<f32> { x = 1.0, y = 0.0, z = -2.0 };
    dt: f32 = 0.5;
    position += velocity * dt;
    if position.x != 10.5 || position.y != 5.0 || position.z != 1.0
        return 20;

    color := std.geom.Vec4::<f32>.splat(0.5);
    if color.dot(color) != 1.0
        return 11;

    ones := std.geom.Vec4::<u64>.one();
    zeros := std.geom.Vec4::<u64>.zero();
    sum := zeros.add(ones);
    if sum.x != 1 || sum.y != 1 || sum.z != 1 || sum.w != 1
        return 12;

    return 0;
}

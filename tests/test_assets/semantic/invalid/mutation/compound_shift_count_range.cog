NEGATIVE_COUNT :: -1;

compound_shift_count_range::() -> void {
    value_u8: u8 = 1;
    value_s32: s32 = 1;

    value_u8 <<= -1;
    value_u8 >>= NEGATIVE_COUNT;
    value_s32 <<= cast(s8, -1);
    value_s32 >>= (1 - 2);

    value_u8 <<= 8;
    value_u8 >>= 9;
    value_s32 <<= 32;
    value_s32 >>= (16 + 16);
}

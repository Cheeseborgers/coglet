Mode::enum(u8) {
    Zero,
    One,
    Two,
}

integer_switch::(value: s32) -> s32 {
    switch value {
        case 1:
            return 11;
        case 2:
            return 22;
        default:
            return 33;
    }
}

boolean_switch::(value: bool) -> s32 {
    switch value {
        case false:
            return 4;
        case true:
            return 5;
    }
}

enum_switch::(value: Mode) -> s32 {
    switch value {
        case Mode.Zero:
            return 1;
        case Mode.One:
            return 2;
        case Mode.Two:
            return 3;
    }
}

main::() -> s32 {
    return integer_switch(2) + boolean_switch(true) + enum_switch(Mode.One);
}

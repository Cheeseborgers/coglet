#extern(c, name="coglet_rt_math_fmod_f32")
fmod_f32::(x: f32, y: f32) -> f32;
#extern(c, name="coglet_rt_math_fmod_f64")
fmod_f64::(x: f64, y: f64) -> f64;

export fmod::(x: f32, y: f32) -> f32 { return fmod_f32(x, y); }
export fmod::(x: f64, y: f64) -> f64 { return fmod_f64(x, y); }

export gcd_u64::(a: u64, b: u64) -> u64 {
    left := a;
    right := b;

    while right != 0 {
        remainder := left % right;
        left = right;
        right = remainder;
    }

    return left;
}

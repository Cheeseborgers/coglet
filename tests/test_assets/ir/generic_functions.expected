module target(pointer=64)
entry @f0 "main"() -> s32 [abi=coglet, linkage=internal] {
  slots:
    $s0 : s32 "left"
    $s1 : s32 "right"
    $s2 : s64 "wide"
  bb0 "entry"():
    %0 = local_addr $s0
    %1 = function_ref @f1
    %2 = const s32 @c0(0x28)
    %3 = call %1(%2)
    store %0, %3
    %4 = local_addr $s1
    %5 = function_ref @f1
    %6 = const s32 @c1(0x2)
    %7 = call %5(%6)
    store %4, %7
    %8 = local_addr $s2
    %9 = function_ref @f2
    %10 = const s64 @c2(0x7)
    %11 = call %9(%10)
    store %8, %11
    %12 = local_addr $s2
    %13 = load %12
    %14 = const s64 @c2(0x7)
    %15 = icmp.ne %13, %14
    cond_br %15, bb1(), bb2()
  bb1 "if.then"():
    %16 = const s32 @c3(0x1)
    ret %16
  bb2 "if.end"():
    %17 = local_addr $s0
    %18 = load %17
    %19 = local_addr $s1
    %20 = load %19
    %21 = iadd.checked %18, %20
    ret %21
}
func @f1 "identity<s32>"(%0: s32) -> s32 [abi=coglet, linkage=internal] {
  slots:
    $s0 : s32 "value"
  bb0 "entry"():
    %1 = local_addr $s0
    store %1, %0
    %2 = local_addr $s0
    %3 = load %2
    ret %3
}
func @f2 "identity<s64>"(%0: s64) -> s64 [abi=coglet, linkage=internal] {
  slots:
    $s0 : s64 "value"
  bb0 "entry"():
    %1 = local_addr $s0
    store %1, %0
    %2 = local_addr $s0
    %3 = load %2
    ret %3
}

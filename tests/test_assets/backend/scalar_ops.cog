bit_mix::(a, b: u32) -> u32 {
    return (~a & b) | (a ^ b);
}

float_check::(a, b: f64) -> bool {
    value := -((a + b) * (a - b) / b);
    return value < -5.0 && value != 0.0 && value <= -5.0 && value > -6.0 && value >= -6.0;
}

float32_check::(a, b: f32) -> bool {
    value := -(a / b);
    return value < -1.0 && value > -2.0;
}

pointer_check::(p: i32*) -> bool {
    return p != null && p == p;
}

main::() -> c_int {
    value: i32 = 9;

    if bit_mix(0x0f0f0f0f, 0x33333333) != 0x3c3c3c3c {
        return 1;
    }

    if !float_check(5.0, 3.0) {
        return 2;
    }

    if !float32_check(3.0, 2.0) {
        return 3;
    }

    if !pointer_check(&value) {
        return 4;
    }

    return 0;
}

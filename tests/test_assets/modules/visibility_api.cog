module visibility;

secret :: 5;
helper::(value: s32) -> s32 { return value + secret; }

export answer :: 40;
export counter: s32 = 1;
export left, right: s32 = 0;

export Mode::enum(u8) {
    Zero,
    One,
}

export Pair::struct {
    x: s32;
    y: s32;
}

export compute::(value: s32) -> s32 {
    left = visibility.helper(value);
    right = visibility.secret;
    return left + right;
}

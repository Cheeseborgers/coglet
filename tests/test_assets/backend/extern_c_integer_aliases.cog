#extern(c)
coglet_backend_integer_alias_probe::(
    schar_value: c_schar,
    uchar_value: c_uchar,
    short_value: c_short,
    ushort_value: c_ushort,
    long_value: c_long,
    ulong_value: c_ulong,
    longlong_value: c_longlong,
    ulonglong_value: c_ulonglong
) -> c_int;

main::() -> c_int {
    return coglet_backend_integer_alias_probe(-1, 2, -3, 4, -5, 6, -7, 8);
}
